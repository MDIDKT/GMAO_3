{% extends 'layouts/app.html.twig' %}

{% block page_title %}Inviter un utilisateur{% endblock %}
{% block page_subtitle %}Creation d'un compte par invitation{% endblock %}

{% block page_content %}
    {% set inputClass = 'block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary transition' %}
    {% set labelClass = 'block text-sm font-medium text-gray-700 mb-2' %}

    <div class="max-w-3xl mx-auto">
        <div class="bg-white rounded-xl shadow-md">
            <div class="px-8 py-6 border-b border-gray-200">
                <h3 class="text-lg font-semibold text-gray-800">Informations utilisateur</h3>
                <p class="text-sm text-gray-600 mt-1">Un email d'invitation sera envoye automatiquement.</p>
            </div>
            <div class="p-8">
                {% for message in app.flashes('success') %}
                    <div class="mb-6 bg-green-50 border border-green-200 text-green-800 rounded-lg p-4 text-sm">
                        {{ message }}
                    </div>
                {% endfor %}

                {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
                    <div>
                        {{ form_label(form.email, null, {'label_attr': {'class': labelClass}}) }}
                        {{ form_widget(form.email, {'attr': {'class': inputClass}}) }}
                        {{ form_errors(form.email) }}
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            {{ form_label(form.nom, null, {'label_attr': {'class': labelClass}}) }}
                            {{ form_widget(form.nom, {'attr': {'class': inputClass}}) }}
                            {{ form_errors(form.nom) }}
                        </div>
                        <div>
                            {{ form_label(form.prenom, null, {'label_attr': {'class': labelClass}}) }}
                            {{ form_widget(form.prenom, {'attr': {'class': inputClass}}) }}
                            {{ form_errors(form.prenom) }}
                        </div>
                    </div>
                    <div>
                        {{ form_label(form.roles, null, {'label_attr': {'class': labelClass}}) }}
                        {{ form_widget(form.roles, {'attr': {'class': inputClass}}) }}
                        {{ form_errors(form.roles) }}
                    </div>
                    <div class="border-t border-gray-200 pt-6">
                        <button type="submit" class="px-6 py-3 bg-primary hover:bg-blue-600 text-white rounded-lg transition font-medium">
                            Envoyer l'invitation
                        </button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
