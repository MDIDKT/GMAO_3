{# templates/email/invitation.html.twig #}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
</head>
<body style="font-family: Arial, sans-serif; background: #f5f5f5; padding: 20px;">
<div style="max-width: 600px; margin: 0 auto; background: white; padding: 30px; border-radius: 8px;">
    <h2>Bienvenue sur la GMAO</h2>
    <p>Bonjour {{ user.prenom }},</p>
    <p>Vous avez été invité(e) à rejoindre la plateforme GMAO.</p>
    <p>Cliquez sur le lien ci-dessous pour activer votre compte et définir votre mot de passe :</p>
    <p>
        <a href="{{ activationUrl }}"
           style="display: inline-block; background: #4f46e5; color: white; padding: 12px 24px; border-radius: 6px; text-decoration: none;">
            Activer mon compte
        </a>
    </p>
    <p style="color: #666; font-size: 14px;">Ce lien expire dans 48 heures.</p>
</div>
</body>
</html>
