<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Demande qualifiée</title>
</head>
<body style="font-family: Arial, sans-serif; background: #f5f5f5; padding: 20px;">
<div style="max-width: 600px; margin: 0 auto; background: white; padding: 30px; border-radius: 8px;">
    <h2>Votre demande avance</h2>
    <p>Bonjour {{ demandeur.prenom }},</p>
    <p>Votre demande <strong>{{ demande.numero }}</strong> a été qualifiée par l'équipe de maintenance.</p>
    <p>Titre : <strong>{{ demande.titre }}</strong></p>
    <p>
        <a href="{{ demandeUrl }}"
           style="display: inline-block; background: #2563eb; color: white; padding: 12px 24px; border-radius: 6px; text-decoration: none;">
            Voir ma demande
        </a>
    </p>
</div>
</body>
</html>
