<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Intervention assignée</title>
</head>
<body style="font-family: Arial, sans-serif; background: #f5f5f5; padding: 20px;">
<div style="max-width: 600px; margin: 0 auto; background: white; padding: 30px; border-radius: 8px;">
    <h2>Nouvelle intervention assignée</h2>
    <p>Bonjour {{ technicien.prenom }},</p>
    <p>L'intervention <strong>{{ intervention.numero }}</strong> vous a été assignée.</p>
    {% if demande %}
        <p>Demande liée : <strong>{{ demande.numero }}</strong> - {{ demande.titre }}</p>
    {% endif %}
    {% if intervention.datePlanifiee %}
        <p>Date planifiée : {{ intervention.datePlanifiee|date('d/m/Y H:i') }}</p>
    {% endif %}
    <p>
        <a href="{{ interventionUrl }}"
           style="display: inline-block; background: #4f46e5; color: white; padding: 12px 24px; border-radius: 6px; text-decoration: none;">
            Voir l'intervention
        </a>
    </p>
    <p style="color: #666; font-size: 14px;">Connectez-vous à la GMAO pour consulter les détails et démarrer l'intervention.</p>
</div>
</body>
</html>
