{% extends 'layouts/app.html.twig' %}

{% block page_title %}Demandes{% endblock %}
{% block page_subtitle %}Gestion des demandes de maintenance{% endblock %}

{% block page_actions %}
    <a href="{{ path('app_demande_new') }}"
       class="bg-primary hover:bg-primary/90 text-white px-4 py-2 rounded-lg font-medium transition flex items-center space-x-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
        </svg>
        <span>Nouvelle demande</span>
    </a>
{% endblock %}

{% block page_content %}
    <div class="bg-white rounded-xl shadow-md p-6 mb-6">
        <form method="get" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 items-end">
            <div>
                <label for="site" class="block text-sm font-medium text-gray-700 mb-1">Site</label>
                <select id="site" name="site" class="w-full rounded-lg border-gray-300 shadow-sm focus:ring-primary focus:border-primary">
                    <option value="">Tous les sites</option>
                    {% for s in sites %}
                        <option value="{{ s.id }}" {{ site and site.id == s.id ? 'selected' : '' }}>{{ s.nom }}</option>
                    {% endfor %}
                </select>
            </div>
            <div>
                <label for="priorite" class="block text-sm font-medium text-gray-700 mb-1">Priorité</label>
                <select id="priorite" name="priorite" class="w-full rounded-lg border-gray-300 shadow-sm focus:ring-primary focus:border-primary">
                    <option value="">Toutes les priorités</option>
                    {% for p in priorites %}
                        <option value="{{ p.value }}" {{ priorite and priorite.value == p.value ? 'selected' : '' }}>{{ p.label() }}</option>
                    {% endfor %}
                </select>
            </div>
            <div>
                <label for="statut" class="block text-sm font-medium text-gray-700 mb-1">Statut</label>
                <select id="statut" name="statut" class="w-full rounded-lg border-gray-300 shadow-sm focus:ring-primary focus:border-primary">
                    <option value="">Tous les statuts</option>
                    {% for st in statuts %}
                        <option value="{{ st.value }}" {{ statut and statut.value == st.value ? 'selected' : '' }}>{{ st.label() }}</option>
                    {% endfor %}
                </select>
            </div>
            <div>
                <label for="search" class="block text-sm font-medium text-gray-700 mb-1">Recherche</label>
                <input type="text" id="search" name="search" value="{{ search }}" placeholder="Titre ou description..." class="w-full rounded-lg border-gray-300 shadow-sm focus:ring-primary focus:border-primary">
            </div>
            <div class="md:col-span-2 lg:col-span-4 flex justify-end gap-3">
                <a href="{{ path('app_demande_index') }}" class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition">Réinitialiser</a>
                <button type="submit" class="px-6 py-2 text-sm font-medium text-white bg-primary rounded-lg hover:bg-primary/90 transition">Filtrer</button>
            </div>
        </form>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
        <div class="bg-white rounded-lg shadow p-4 border-l-4 border-danger">
            <p class="text-sm text-gray-600 font-medium">Demandes urgentes</p>
            <p class="text-2xl font-bold text-gray-800 mt-1">{{ urgentCount }}</p>
        </div>
        <div class="bg-white rounded-lg shadow p-4 border-l-4 border-warning">
            <p class="text-sm text-gray-600 font-medium">Demandes ouvertes</p>
            <p class="text-2xl font-bold text-gray-800 mt-1">{{ openCount }}</p>
        </div>
        <div class="bg-white rounded-lg shadow p-4 border-l-4 border-success">
            <p class="text-sm text-gray-600 font-medium">Demandes cloturees</p>
            <p class="text-2xl font-bold text-gray-800 mt-1">{{ closedCount }}</p>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-md overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
            <p class="text-sm font-medium text-gray-700">{{ totalCount }} demandes trouvees</p>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Numero
                    </th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Titre
                    </th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Priorite
                    </th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Statut
                    </th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Site
                    </th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Creation
                    </th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions
                    </th>
                </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                {% for demande in pagination %}
                    {% set prioriteClass = 'bg-gray-100 text-gray-800' %}
                    {% if demande.priorite %}
                        {% if demande.priorite.value == 'p1_URGENTE' %}
                            {% set prioriteClass = 'bg-red-100 text-red-800' %}
                        {% elseif demande.priorite.value == 'p2_HAUTE' %}
                            {% set prioriteClass = 'bg-orange-100 text-orange-800' %}
                        {% elseif demande.priorite.value == 'p3_NORMALE' %}
                            {% set prioriteClass = 'bg-blue-100 text-blue-800' %}
                        {% elseif demande.priorite.value == 'p4_BASSE' %}
                            {% set prioriteClass = 'bg-gray-100 text-gray-800' %}
                        {% endif %}
                    {% endif %}

                    {% set statutClass = 'bg-gray-100 text-gray-800' %}
                    {% if demande.statut %}
                        {% if demande.statut.value == 'EN_COURS' %}
                            {% set statutClass = 'bg-blue-100 text-blue-800' %}
                        {% elseif demande.statut.value == 'PLANIFIE' or demande.statut.value == 'A_QUALIFIER' or demande.statut.value == 'QUALIFIE' %}
                            {% set statutClass = 'bg-yellow-100 text-yellow-800' %}
                        {% elseif demande.statut.value == 'CLOTURE' %}
                            {% set statutClass = 'bg-green-100 text-green-800' %}
                        {% elseif demande.statut.value == 'REJETEE' %}
                            {% set statutClass = 'bg-red-100 text-red-800' %}
                        {% endif %}
                    {% endif %}

                    <tr class="hover:bg-gray-50 transition">
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                            {{ demande.numero ?: ('DEM-' ~ demande.id) }}
                        </td>
                        <td class="px-6 py-4">
                            <div class="text-sm font-medium text-gray-900">{{ demande.titre }}</div>
                            <div class="text-xs text-gray-500">
                                {% if demande.description %}
                                    {{ demande.description|length > 70 ? demande.description|slice(0, 70) ~ '...' : demande.description }}
                                {% else %}
                                    Aucune description
                                {% endif %}
                            </div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span
                                class="px-3 py-1 inline-flex text-xs leading-5 font-semibold rounded-full {{ prioriteClass }}">
                                {{ demande.priorite ? demande.priorite.label() : '-' }}
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span
                                class="px-3 py-1 inline-flex text-xs leading-5 font-semibold rounded-full {{ statutClass }}">
                                {{ demande.statut ? demande.statut.label() : '-' }}
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">{{ demande.site ? demande.site.nom : '-' }}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">{{ demande.createdAt ? demande.createdAt|date('d/m/Y H:i') : '-' }}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                            <div class="flex items-center gap-4">
                                <a href="{{ path('app_demande_show', {'id': demande.id}) }}"
                                   class="text-primary hover:text-primary/80">Voir</a>
                                <a href="{{ path('app_demande_edit', {'id': demande.id}) }}"
                                   class="text-gray-700 hover:text-gray-900">Modifier</a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>

                    <td colspan="7" class="px-6 py-10 text-center text-gray-500">Aucune demande trouvee.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {% if pagination.pageCount > 1 %}
        <div class="mt-6 flex justify-center">
            <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px">
                {% if pagination.currentPageNumber > 1 %}
                    <a href="{{ path('app_demande_index', {page: pagination.currentPageNumber - 1, site: selectedSite, priorite: selectedPriorite, statut: selectedStatut, search: selectedSearch}) }}"
                       class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50">
                        Precedent
                    </a>
                {% endif %}
                {% for page in 1..pagination.pageCount %}
                    <a href="{{ path('app_demande_index', {page: page, site: selectedSite, priorite: selectedPriorite, statut: selectedStatut, search: selectedSearch}) }}"
                       class="relative inline-flex items-center px-4 py-2 border border-gray-300 bg-white text-sm font-medium {{ page == pagination.currentPageNumber ? 'text-blue-600 bg-blue-50' : 'text-gray-700 hover:bg-gray-50' }}">
                        {{ page }}
                    </a>
                {% endfor %}
                {% if pagination.currentPageNumber < pagination.pageCount %}
                    <a href="{{ path('app_demande_index', {page: pagination.currentPageNumber + 1, site: selectedSite, priorite: selectedPriorite, statut: selectedStatut, search: selectedSearch}) }}"
                       class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50">
                        Suivant
                    </a>
                {% endif %}
            </nav>
        </div>
    {% endif %}
{% endblock %}
