{% extends 'layouts/app.html.twig' %}

{% block page_title %}{{ demande.numero ?: ('Demande #' ~ demande.id) }}{% endblock %}
{% block page_subtitle %}Detail de la demande{% endblock %}

{% block page_actions %}
    {% if demande.statut and demande.statut.value != 'CLOTURE' and demande.statut.value != 'REJETEE'
          and (is_granted('ROLE_PLANIFICATEUR') or is_granted('ROLE_ADMIN')) %}
        <a href="{{ path('app_intervention_new', {'demande': demande.id}) }}"
           class="px-4 py-2 bg-primary text-white rounded-xl hover:bg-primary/90 transition font-medium mr-2">
            Planifier une intervention
        </a>
    {% endif %}
    <a href="{{ path('app_demande_edit', {'id': demande.id}) }}"
       class="px-4 py-2 border border-gray-300 dark:border-white/10 text-gray-700 dark:text-gray-200 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5 transition font-medium">
        Modifier
    </a>
{% endblock %}

{% block page_content %}
    {% set prioriteClass = 'bg-gray-100 text-gray-800' %}
    {% if demande.priorite %}
        {% if demande.priorite.value == 'p1_URGENTE' %}
            {% set prioriteClass = 'bg-red-100 text-red-800' %}
        {% elseif demande.priorite.value == 'p2_HAUTE' %}
            {% set prioriteClass = 'bg-orange-100 text-orange-800' %}
        {% elseif demande.priorite.value == 'p3_NORMALE' %}
            {% set prioriteClass = 'bg-blue-100 text-blue-800' %}
        {% endif %}
    {% endif %}

    {% set statutClass = 'bg-gray-100 text-gray-800' %}
    {% if demande.statut %}
        {% if demande.statut.value == 'EN_COURS' %}
            {% set statutClass = 'bg-blue-100 text-blue-800' %}
        {% elseif demande.statut.value == 'PLANIFIE' or demande.statut.value == 'A_QUALIFIER' or demande.statut.value == 'QUALIFIE' %}
            {% set statutClass = 'bg-yellow-100 text-yellow-800' %}
        {% elseif demande.statut.value == 'CLOTURE' %}
            {% set statutClass = 'bg-green-100 text-green-800' %}
        {% elseif demande.statut.value == 'REJETEE' %}
            {% set statutClass = 'bg-red-100 text-red-800' %}
        {% endif %}
    {% endif %}

    <div class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 bg-white dark:bg-fonddeux rounded-2xl shadow-md dark:shadow-none border border-gray-200 dark:border-white/10 p-6">
            <div class="flex items-start justify-between mb-6">
                <div>
                    <h3 class="text-xl font-bold text-gray-800 dark:text-white mb-2">Informations de la demande</h3>
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="px-3 py-1 text-sm font-semibold rounded-full {{ prioriteClass }}">
                            {{ demande.priorite ? demande.priorite.label() : 'Priorite non definie' }}
                        </span>
                        <span class="px-3 py-1 text-sm font-semibold rounded-full {{ statutClass }}">
                            {{ demande.statut ? demande.statut.label() : 'Statut non defini' }}
                        </span>
                    </div>
                </div>
            </div>

            <div class="space-y-4">
                <div>
                    <p class="text-sm font-medium text-gray-500 mb-1">Numero</p>
                    <p class="text-gray-800 dark:text-white">{{ demande.numero ?: '-' }}</p>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-500 mb-1">Titre</p>
                    <p class="text-gray-800 dark:text-white">{{ demande.titre }}</p>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-500 mb-1">Description</p>
                    <p class="text-gray-800 dark:text-white whitespace-pre-line">{{ demande.description ?: '-' }}</p>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <p class="text-sm font-medium text-gray-500 mb-1">Site</p>
                        <p class="text-gray-800 dark:text-white">{{ demande.site ? demande.site.nom : '-' }}</p>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-gray-500 mb-1">Batiment</p>
                        <p class="text-gray-800 dark:text-white">{{ demande.batiment ? demande.batiment.nom : '-' }}</p>
                    </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <p class="text-sm font-medium text-gray-500 mb-1">Equipement</p>
                        <p class="text-gray-800 dark:text-white">{{ demande.equipement ? demande.equipement.nom : '-' }}</p>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-gray-500 mb-1">Demandeur</p>
                        <p class="text-gray-800 dark:text-white">
                            {% if demande.user %}
                                {{ demande.user.prenom }} {{ demande.user.nom }}
                            {% else %}
                                -
                            {% endif %}
                        </p>
                    </div>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-500 mb-1">Organisation</p>
                    <p class="text-gray-800 dark:text-white">{{ demande.organisation ? demande.organisation.nom : '-' }}</p>
                </div>
                {% if demande.photos|length > 0 %}
                    <div>
                        <p class="text-sm font-medium text-gray-500 mb-2">Photos</p>
                        <div class="flex flex-wrap gap-5">
                            {% for photo in demande.photos %}
                                <a href="{{ path('photo_show', {'id': photo.id}) }}" target="_blank">
                                    <img src="{{ path('photo_show', {'id': photo.id}) }}"
                                         alt="{{ photo.originalName ?: 'Photo' }}"
                                         class="h-56 w-56 object-cover rounded-xl border border-gray-200 dark:border-white/10 hover:opacity-80 transition">
                                </a>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>

        <div class="space-y-6">
            <div class="bg-white dark:bg-fonddeux rounded-2xl shadow-md dark:shadow-none border border-gray-200 dark:border-white/10 p-6 kpi-accent-primary">
                <p class="text-sm text-gray-600 dark:text-gray-300 font-medium">ID demande</p>
                <p class="text-3xl font-bold text-gray-800 dark:text-white mt-1">{{ demande.id }}</p>
            </div>
            <div class="bg-white dark:bg-fonddeux rounded-2xl shadow-md dark:shadow-none border border-gray-200 dark:border-white/10 p-6 kpi-accent-secondary">
                <p class="text-sm text-gray-600 dark:text-gray-300 font-medium">Creee le</p>
                <p class="text-lg font-semibold text-gray-800 dark:text-white mt-1">{{ demande.createdAt ? demande.createdAt|date('d/m/Y H:i') : '-' }}</p>
                <p class="text-sm text-gray-500 mt-2">Maj: {{ demande.updatedAt ? demande.updatedAt|date('d/m/Y H:i') : '-' }}</p>
            </div>
            <div class="bg-white dark:bg-fonddeux rounded-2xl shadow-md dark:shadow-none border border-gray-200 dark:border-white/10 p-6">
                <div class="flex flex-col gap-3">
                    <a href="{{ is_granted('ROLE_ADMIN') or is_granted('ROLE_PLANIFICATEUR') ? path('app_demande_index') : path('app_demande_mes_demandes') }}"
                       class="text-center px-4 py-2 border border-gray-300 dark:border-white/10 text-gray-700 dark:text-gray-200 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5 transition font-medium">
                        Retour a la liste
                    </a>
                    {% if demande.statut and demande.statut.value == 'A_QUALIFIER' and (is_granted('ROLE_PLANIFICATEUR') or is_granted('ROLE_ADMIN')) %}
                        <form method="post" action="{{ path('app_demande_qualifier', {'id': demande.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('qualifier' ~ demande.id) }}">
                            <button type="submit"
                                    class="w-full px-4 py-2 bg-primary hover:bg-primary/90 text-white rounded-xl transition font-medium">
                                Qualifier
                            </button>
                        </form>
                    {% endif %}

                    {% if demande.statut and (demande.statut.value == 'A_QUALIFIER' or demande.statut.value == 'QUALIFIE') and (is_granted('ROLE_PLANIFICATEUR') or is_granted('ROLE_ADMIN')) %}
                        <form method="post" action="{{ path('app_demande_rejeter', {'id': demande.id}) }}" onsubmit="return this.motif_rejet.value.trim() !== '' || (alert('Le motif de rejet est obligatoire.'), false);">
                            <input type="hidden" name="_token" value="{{ csrf_token('rejeter' ~ demande.id) }}">
                            <textarea name="motif_rejet" rows="2" placeholder="Motif de rejet (obligatoire)"
                                      class="w-full px-3 py-2 border border-gray-300 dark:border-white/10 rounded-xl text-sm mb-2 focus:ring-2 focus:ring-red-500 focus:border-red-500 bg-gray-50 dark:bg-fondun text-gray-900 dark:text-white"></textarea>
                            <button type="submit"
                                    class="w-full px-4 py-2 bg-danger hover:bg-danger/90 text-white rounded-xl transition font-medium">
                                Rejeter
                            </button>
                        </form>
                    {% endif %}

                    {{ include('demande/_delete_form.html.twig') }}
                </div>
            </div>

            {% if demande.motifRejet %}
                <div class="bg-white dark:bg-fonddeux rounded-2xl shadow-md dark:shadow-none border border-gray-200 dark:border-white/10 p-6 kpi-accent-danger">
                    <p class="text-sm text-gray-600 dark:text-gray-300 font-medium">Motif de rejet</p>
                    <p class="text-sm text-gray-800 dark:text-white mt-2 whitespace-pre-line">{{ demande.motifRejet }}</p>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
