{% extends 'layouts/app.html.twig' %}

{% block page_title %}{{ demande.titre }}{% endblock %}
{% block page_subtitle %}Détail de la demande{% endblock %}

{% block page_content %}
    {% set prioriteClass = 'bg-gray-100 dark:bg-fondun text-gray-800 dark:text-white' %}
    {% if demande.priorite %}
        {% if demande.priorite.value == 'p1_URGENTE' %}
            {% set prioriteClass = 'bg-red-100 dark:bg-red-900/30 text-red-800 dark:text-red-400' %}
        {% elseif demande.priorite.value == 'p2_HAUTE' %}
            {% set prioriteClass = 'bg-orange-100 dark:bg-orange-900/30 text-orange-800 dark:text-orange-400' %}
        {% elseif demande.priorite.value == 'p3_NORMALE' %}
            {% set prioriteClass = 'bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-400' %}
        {% endif %}
    {% endif %}

    {% set statutClass = 'bg-gray-100 dark:bg-fondun text-gray-800 dark:text-white' %}
    {% if demande.statut %}
        {% if demande.statut.value == 'EN_COURS' %}
            {% set statutClass = 'bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-400' %}
        {% elseif demande.statut.value == 'PLANIFIE' or demande.statut.value == 'A_QUALIFIER' or demande.statut.value == 'QUALIFIE' %}
            {% set statutClass = 'bg-yellow-100 dark:bg-yellow-900/30 text-yellow-800 dark:text-yellow-400' %}
        {% elseif demande.statut.value == 'CLOTURE' %}
            {% set statutClass = 'bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-400' %}
        {% elseif demande.statut.value == 'REJETEE' %}
            {% set statutClass = 'bg-red-100 dark:bg-red-900/30 text-red-800 dark:text-red-400' %}
        {% endif %}
    {% endif %}

    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
        {# Partie gauche : Informations #}
        <div class="bg-white dark:bg-fonddeux rounded-2xl shadow-md dark:shadow-none border border-gray-200 dark:border-white/10 p-6 h-fit">
            <div class="flex items-start justify-between mb-6">
                <div>
                    <h3 class="text-xl font-bold text-gray-800 dark:text-white mb-2">Informations de la demande</h3>
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="px-3 py-1 text-sm font-semibold rounded-full {{ prioriteClass }}">
                            {{ demande.priorite ? demande.priorite.label() : 'Priorité non définie' }}
                        </span>
                        <span class="px-3 py-1 text-sm font-semibold rounded-full {{ statutClass }}">
                            {{ demande.statut ? demande.statut.label() : 'Statut non défini' }}
                        </span>
                    </div>
                </div>
            </div>

            <div class="space-y-4">
                <div>
                    <p class="text-sm font-medium text-gray-500 mb-1">Titre</p>
                    <p class="text-gray-800 dark:text-white">{{ demande.titre }}</p>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-500 mb-1">Description</p>
                    <p class="text-gray-800 dark:text-white whitespace-pre-line">{{ demande.description ?: '-' }}</p>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <p class="text-sm font-medium text-gray-500 mb-1">Site</p>
                        <p class="text-gray-800 dark:text-white">{{ demande.site ? demande.site.nom : '-' }}</p>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-gray-500 mb-1">Bâtiment</p>
                        <p class="text-gray-800 dark:text-white">{{ demande.batiment ? demande.batiment.nom : '-' }}</p>
                    </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <p class="text-sm font-medium text-gray-500 mb-1">Équipement</p>
                        <p class="text-gray-800 dark:text-white">{{ demande.equipement ? demande.equipement.nom : '-' }}</p>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-gray-500 mb-1">Demandeur</p>
                        <p class="text-gray-800 dark:text-white">
                            {% if demande.user %}
                                {{ demande.user.prenom }} {{ demande.user.nom }}
                            {% else %}
                                -
                            {% endif %}
                        </p>
                    </div>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-500 mb-1">Organisation</p>
                    <p class="text-gray-800 dark:text-white">{{ demande.organisation ? demande.organisation.nom : '-' }}</p>
                </div>
                {% if demande.motifRejet %}
                    <div>
                        <p class="text-sm font-medium text-gray-500 mb-1">Motif de rejet</p>
                        <p class="text-red-800 dark:text-red-400 whitespace-pre-line">{{ demande.motifRejet }}</p>
                    </div>
                {% endif %}
                {% if demande.photos|length > 0 %}
                    <div class="mt-2">
                        <p class="text-sm font-medium text-gray-500 mb-2">Photos</p>
                        <div class="flex flex-wrap gap-3">
                            {% for photo in demande.photos %}
                                <a href="{{ path('photo_show', {'id': photo.id}) }}" target="_blank" rel="noopener noreferrer">
                                    <img src="{{ path('photo_show', {'id': photo.id}) }}"
                                         alt="{{ photo.originalName ?: 'Photo' }}"
                                         class="h-24 w-24 object-cover rounded-xl border border-gray-200 dark:border-white/10 hover:opacity-80 transition">
                                </a>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>

        {# Partie droite : Actions contextuelles #}
        <div class="bg-white dark:bg-fonddeux rounded-2xl shadow-md dark:shadow-none border border-gray-200 dark:border-white/10 p-6 h-fit">
            <h3 class="text-lg font-bold text-gray-800 dark:text-white mb-4">Traitement de la demande</h3>
            <div class="grid grid-cols-2 gap-3">
                {% if demande.statut and demande.statut.value != 'EN_COURS' and demande.statut.value != 'CLOTURE' and demande.statut.value != 'REJETEE'
                      and (is_granted('ROLE_PLANIFICATEUR') or is_granted('ROLE_ADMIN')) %}
                    <a href="{{ path('app_intervention_new', {'demande': demande.id}) }}"
                       class="inline-flex items-center justify-center w-full px-4 py-2.5 bg-primary text-white rounded-xl hover:bg-primary/90 transition font-medium text-sm">
                        Affecter la demande
                    </a>
                {% endif %}

                {# 2. Actions neutres #}
                {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_PLANIFICATEUR') %}
                    <a href="{{ path('app_demande_edit', {'id': demande.id}) }}"
                       class="inline-flex items-center justify-center w-full px-4 py-2.5 border border-gray-300 dark:border-white/10 text-gray-700 dark:text-gray-200 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5 transition font-medium text-sm">
                        Modifier
                    </a>
                {% endif %}

                <a href="{{ is_granted('ROLE_ADMIN') or is_granted('ROLE_PLANIFICATEUR') ? path('app_demande_index') : path('app_demande_mes_demandes') }}"
                   class="inline-flex items-center justify-center w-full px-4 py-2.5 border border-gray-300 dark:border-white/10 text-gray-700 dark:text-gray-200 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5 transition font-medium text-sm">
                    Retour à la liste
                </a>
            </div>

            {# 3. Actions destructrices — séparateur visuel #}
            {% if demande.statut and demande.statut.value == 'A_QUALIFIER' and (is_granted('ROLE_PLANIFICATEUR') or is_granted('ROLE_ADMIN')) %}
                <div class="border-t border-gray-200 dark:border-white/10 pt-4 mt-4">
                    <form method="post" action="{{ path('app_demande_rejeter', {'id': demande.id}) }}"
                          onsubmit="return this.motif_rejet.value.trim() !== '' || (alert('Le motif de rejet est obligatoire.'), false);">
                        <input type="hidden" name="_token" value="{{ csrf_token('rejeter' ~ demande.id) }}">
                        <div class="flex flex-col sm:flex-row gap-3 items-start">
                            <div class="flex-1 w-full">
                                <label for="motif_rejet"></label><textarea id="motif_rejet" name="motif_rejet" rows="1"
                                                                           required
                                                                           class="w-full rounded-xl border-gray-300 dark:border-white/10 shadow-sm focus:ring-red-500 focus:border-red-500 text-sm bg-gray-50 dark:bg-fondun text-gray-900 dark:text-white"
                                                                           placeholder="Motif de rejet..."></textarea>
                            </div>
                            <button type="submit"
                                    class="px-4 py-2.5 bg-danger hover:bg-danger/90 text-white rounded-xl transition font-medium text-sm whitespace-nowrap">
                                Rejeter
                            </button>
                        </div>
                    </form>
                </div>
            {% endif %}

            <div class="border-t border-gray-200 dark:border-white/10 pt-4 mt-4">
                {{ include('demande/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
{% endblock %}
