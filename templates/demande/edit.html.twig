{% extends 'layouts/app.html.twig' %}

{% block page_title %}Modifier la demande{% endblock %}
{% block page_subtitle %}Mise a jour des informations de la demande{% endblock %}

{% block page_content %}
    <div class="max-w-4xl mx-auto space-y-6">
        <div class="bg-white dark:bg-fonddeux rounded-2xl shadow-md dark:shadow-none border border-gray-200 dark:border-white/10">
            <div class="px-8 py-6 border-b border-gray-200 dark:border-white/10">
                <h3 class="text-lg font-semibold text-gray-800 dark:text-white">Edition</h3>
                <p class="text-sm text-gray-600 dark:text-gray-300 mt-1">Modifiez les informations et enregistrez</p>
            </div>
            <div class="p-8">
                {{ include('demande/_form.html.twig', {'button_label': 'Mettre a jour', 'cancel_path': path('app_demande_show', {'id': demande.id})}) }}
            </div>
        </div>

        <div class="bg-white dark:bg-fonddeux rounded-2xl shadow-md dark:shadow-none border border-gray-200 dark:border-white/10 p-6">
            <h4 class="text-sm font-semibold text-gray-700 dark:text-gray-200 mb-4">Suppression</h4>
            {{ include('demande/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}
