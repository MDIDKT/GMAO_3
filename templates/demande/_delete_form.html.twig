<form method="post" action="{{ path('app_demande_delete', {'id': demande.id}) }}" onsubmit="return confirm('Confirmer la suppression de cette demande ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ demande.id) }}">
    <button class="px-5 py-2 bg-danger hover:bg-red-600 text-white rounded-xl transition font-medium text-sm">Supprimer</button>
</form>
