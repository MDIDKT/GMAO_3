{% extends 'layouts/app.html.twig' %}

{% block page_title %}Modifier le site{% endblock %}
{% block page_subtitle %}Mise a jour des informations du site{% endblock %}

{% block page_content %}
    <div class="max-w-3xl mx-auto space-y-6">
        <div class="bg-white rounded-xl shadow-md">
            <div class="px-8 py-6 border-b border-gray-200">
                <h3 class="text-lg font-semibold text-gray-800">Edition</h3>
                <p class="text-sm text-gray-600 mt-1">Modifiez les informations et enregistrez les changements</p>
            </div>
            <div class="p-8">
                {{ include('site/_form.html.twig', {'button_label': 'Mettre a jour', 'cancel_path': path('app_site_show', {'id': site.id})}) }}
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-md p-6">
            <h4 class="text-sm font-semibold text-gray-700 mb-4">Suppression</h4>
            {{ include('site/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}
