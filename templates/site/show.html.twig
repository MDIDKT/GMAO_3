{% extends 'base.html.twig' %}

{% block title %}Site{% endblock %}

{% block body %}
    <h1>Site</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ site.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ site.nom }}</td>
            </tr>
            <tr>
                <th>Adresse</th>
                <td>{{ site.adresse }}</td>
            </tr>
            <tr>
                <th>CodePostal</th>
                <td>{{ site.codePostal }}</td>
            </tr>
            <tr>
                <th>Ville</th>
                <td>{{ site.ville }}</td>
            </tr>
            <tr>
                <th>Telephone</th>
                <td>{{ site.telephone }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ site.email }}</td>
            </tr>
            <tr>
                <th>Actif</th>
                <td>{{ site.actif ? 'Yes' : 'No' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_site_index') }}">back to list</a>

    <a href="{{ path('app_site_edit', {'id': site.id}) }}">edit</a>

    {{ include('site/_delete_form.html.twig') }}
{% endblock %}
