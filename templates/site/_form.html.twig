{% set inputClass = 'block w-full px-4 py-3 border border-gray-300 dark:border-white/10 rounded-xl focus:ring-2 focus:ring-primary focus:border-primary transition bg-gray-50 dark:bg-fondun text-gray-900 dark:text-white dark:placeholder-gray-500' %}
{% set labelClass = 'block text-sm font-medium text-gray-700 dark:text-gray-200 mb-2' %}
{% set cancelPath = cancel_path|default(path('app_site_index')) %}

{{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
    <div>
        {{ form_label(form.nom, null, {'label_attr': {'class': labelClass}}) }}
        {{ form_widget(form.nom, {'attr': {'class': inputClass, 'placeholder': 'Ex: Batiment Principal'}}) }}
        {{ form_errors(form.nom) }}
    </div>

    <div>
        {{ form_label(form.adresse, null, {'label_attr': {'class': labelClass}}) }}
        {{ form_widget(form.adresse, {'attr': {'class': inputClass, 'rows': 3, 'placeholder': 'Adresse complete du site'}}) }}
        {{ form_errors(form.adresse) }}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
            {{ form_label(form.codePostal, null, {'label_attr': {'class': labelClass}}) }}
            {{ form_widget(form.codePostal, {'attr': {'class': inputClass, 'placeholder': '75000'}}) }}
            {{ form_errors(form.codePostal) }}
        </div>
        <div>
            {{ form_label(form.ville, null, {'label_attr': {'class': labelClass}}) }}
            {{ form_widget(form.ville, {'attr': {'class': inputClass, 'placeholder': 'Paris'}}) }}
            {{ form_errors(form.ville) }}
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
            {{ form_label(form.telephone, null, {'label_attr': {'class': labelClass}}) }}
            {{ form_widget(form.telephone, {'attr': {'class': inputClass, 'placeholder': '+33 1 23 45 67 89'}}) }}
            {{ form_errors(form.telephone) }}
        </div>
        <div>
            {{ form_label(form.email, null, {'label_attr': {'class': labelClass}}) }}
            {{ form_widget(form.email, {'attr': {'class': inputClass, 'placeholder': 'contact@site.fr'}}) }}
            {{ form_errors(form.email) }}
        </div>
    </div>

    <div>
        <label class="{{ labelClass }}">Statut</label>
        <div class="flex items-center gap-2">
            {{ form_widget(form.actif, {'attr': {'class': 'h-4 w-4 text-primary border-gray-300 dark:border-white/10 rounded focus:ring-primary bg-gray-50 dark:bg-fondun'}}) }}
            {{ form_label(form.actif, 'Actif', {'label_attr': {'class': 'text-sm text-gray-700 dark:text-gray-200 mb-0'}}) }}
        </div>
        {{ form_errors(form.actif) }}
    </div>

    <div class="border-t border-gray-200 dark:border-white/10 pt-6 flex items-center justify-between">
        <a href="{{ cancelPath }}" class="px-6 py-3 border border-gray-300 dark:border-white/10 text-gray-700 dark:text-gray-200 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5 transition font-medium">
            Annuler
        </a>
        <button class="px-6 py-3 bg-primary hover:bg-primary/90 text-white rounded-xl transition font-medium">
            {{ button_label|default('Enregistrer') }}
        </button>
    </div>
{{ form_end(form) }}
