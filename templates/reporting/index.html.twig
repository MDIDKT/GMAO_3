{% extends 'layouts/app.html.twig' %}

{% block page_title %}Reporting{% endblock %}
{% block page_subtitle %}Indicateurs de pilotage maintenance{% endblock %}

{% block page_content %}

    {# ── Filtres ── #}
    <form method="GET" action="{{ path('app_reporting') }}" class="bg-white dark:bg-fonddeux rounded-2xl shadow-md dark:shadow-none border border-gray-200 dark:border-white/10 p-4 mb-6">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
            <div>
                <label for="site" class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1">Site</label>
                <select name="site" id="site" class="w-full rounded-xl border-gray-300 dark:border-white/10 shadow-sm dark:shadow-none text-sm bg-gray-50 dark:bg-fondun text-gray-900 dark:text-white">
                    <option value="">Tous les sites</option>
                    {% for s in sites %}
                        <option value="{{ s.id }}" {{ selectedSite == s.id ? 'selected' : '' }}>{{ s.nom }}</option>
                    {% endfor %}
                </select>
            </div>
            <div>
                <label for="date_debut" class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1">Date début</label>
                <input type="date" name="date_debut" id="date_debut" value="{{ dateDebut }}"
                       class="w-full rounded-xl border-gray-300 dark:border-white/10 shadow-sm dark:shadow-none text-sm bg-gray-50 dark:bg-fondun text-gray-900 dark:text-white">
            </div>
            <div>
                <label for="date_fin" class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1">Date fin</label>
                <input type="date" name="date_fin" id="date_fin" value="{{ dateFin }}"
                       class="w-full rounded-xl border-gray-300 dark:border-white/10 shadow-sm dark:shadow-none text-sm bg-gray-50 dark:bg-fondun text-gray-900 dark:text-white">
            </div>
            <div>
                <button type="submit"
                        class="w-full bg-primary text-white px-4 py-2 rounded-xl text-sm font-medium hover:bg-primary/90 transition">
                    Filtrer
                </button>
            </div>
        </div>
    </form>

    {# ── KPI 1 : Demandes par statut + KPI 2 : Délai moyen ── #}
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">

        {# KPI 1 #}
        <div class="bg-white dark:bg-fonddeux rounded-2xl shadow-md dark:shadow-none border border-gray-200 dark:border-white/10 p-6">
            <h3 class="text-lg font-semibold text-gray-800 dark:text-white mb-4">Demandes par statut</h3>
            {% if demandesParStatut is empty %}
                <p class="text-gray-500 dark:text-gray-400 text-sm">Aucune demande pour cette période.</p>
            {% else %}
                <div class="space-y-3">
                    {% set statutColors = {
                        'NOUVEAU': 'bg-gray-100 dark:bg-fondun text-gray-800 dark:text-white',
                        'A_QUALIFIER': 'bg-yellow-100 dark:bg-yellow-900/30 text-yellow-800 dark:text-yellow-400',
                        'QUALIFIE': 'bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-400',
                        'PLANIFIE': 'bg-indigo-100 dark:bg-indigo-900/30 text-indigo-800 dark:text-indigo-400',
                        'EN_COURS': 'bg-orange-100 dark:bg-orange-900/30 text-orange-800 dark:text-orange-400',
                        'CLOTURE': 'bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-400',
                        'REJETEE': 'bg-red-100 dark:bg-red-900/30 text-red-800 dark:text-red-400'
                    } %}
                    {% set statutLabels = {
                        'NOUVEAU': 'Nouveau',
                        'A_QUALIFIER': 'À qualifier',
                        'QUALIFIE': 'Qualifié',
                        'PLANIFIE': 'Planifié',
                        'EN_COURS': 'En cours',
                        'CLOTURE': 'Clôturé',
                        'REJETEE': 'Rejetée'
                    } %}
                    {% for row in demandesParStatut %}
                        {% set statutKey = row.statut.name is defined ? row.statut.name : row.statut %}
                        <div class="flex items-center justify-between">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium {{ statutColors[statutKey] ?? 'bg-gray-100 dark:bg-fondun text-gray-800 dark:text-white' }}">
                                {{ statutLabels[statutKey] ?? statutKey }}
                            </span>
                            <span class="text-lg font-bold text-gray-900 dark:text-white">{{ row.total }}</span>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        {# KPI 2 #}
        <div class="bg-white dark:bg-fonddeux rounded-2xl shadow-md dark:shadow-none border border-gray-200 dark:border-white/10 p-6">
            <h3 class="text-lg font-semibold text-gray-800 dark:text-white mb-4">Délai moyen de traitement</h3>
            <div class="flex items-center justify-center h-32">
                {% if delaiMoyen is not null %}
                    {% if delaiMoyen >= 24 %}
                        <div class="text-center">
                            <span class="text-4xl font-bold text-primary">{{ (delaiMoyen / 24)|round(1) }}</span>
                            <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">jours en moyenne</p>
                            <p class="text-xs text-gray-400 dark:text-gray-500">({{ delaiMoyen }} heures)</p>
                        </div>
                    {% else %}
                        <div class="text-center">
                            <span class="text-4xl font-bold text-primary">{{ delaiMoyen }}</span>
                            <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">heures en moyenne</p>
                        </div>
                    {% endif %}
                {% else %}
                    <p class="text-gray-500 dark:text-gray-400 text-sm">Aucune demande clôturée pour cette période.</p>
                {% endif %}
            </div>
            <p class="text-xs text-gray-400 dark:text-gray-500 mt-2">Calculé sur les demandes clôturées (création &rarr; clôture)</p>
        </div>
    </div>

    {# ── KPI 3 : Interventions par technicien ── #}
    <div class="bg-white dark:bg-fonddeux rounded-2xl shadow-md dark:shadow-none border border-gray-200 dark:border-white/10 p-6 mb-6">
        <h3 class="text-lg font-semibold text-gray-800 dark:text-white mb-4">Interventions par technicien</h3>
        {% if interventionsParTechnicien is empty %}
            <p class="text-gray-500 dark:text-gray-400 text-sm">Aucune intervention assignée pour cette période.</p>
        {% else %}
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200 dark:divide-white/10">
                    <thead class="bg-gray-50 dark:bg-fondun">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Technicien</th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Interventions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200 dark:divide-white/10">
                        {% for row in interventionsParTechnicien %}
                            <tr>
                                <td class="px-6 py-3 text-sm text-gray-900 dark:text-white">{{ row.technicienNom }}</td>
                                <td class="px-6 py-3 text-sm text-right font-semibold text-gray-900 dark:text-white">{{ row.total }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>

    {# ── KPI 4 : Demandes par site et priorité ── #}
    <div class="bg-white dark:bg-fonddeux rounded-2xl shadow-md dark:shadow-none border border-gray-200 dark:border-white/10 p-6">
        <h3 class="text-lg font-semibold text-gray-800 dark:text-white mb-4">Demandes par site et priorité</h3>
        {% if demandesParSitePriorite is empty %}
            <p class="text-gray-500 dark:text-gray-400 text-sm">Aucune demande pour cette période.</p>
        {% else %}
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200 dark:divide-white/10">
                    <thead class="bg-gray-50 dark:bg-fondun">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Site</th>
                            <th class="px-6 py-3 text-center text-xs font-medium text-red-600 uppercase">P1 Urgente</th>
                            <th class="px-6 py-3 text-center text-xs font-medium text-orange-600 uppercase">P2 Haute</th>
                            <th class="px-6 py-3 text-center text-xs font-medium text-yellow-600 uppercase">P3 Normale</th>
                            <th class="px-6 py-3 text-center text-xs font-medium text-green-600 uppercase">P4 Basse</th>
                            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Total</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200 dark:divide-white/10">
                        {% for row in demandesParSitePriorite %}
                            <tr>
                                <td class="px-6 py-3 text-sm text-gray-900 dark:text-white font-medium">{{ row.siteNom }}</td>
                                <td class="px-6 py-3 text-sm text-center {{ row.P1_URGENTE > 0 ? 'text-red-600 font-bold' : 'text-gray-400' }}">{{ row.P1_URGENTE }}</td>
                                <td class="px-6 py-3 text-sm text-center {{ row.P2_HAUTE > 0 ? 'text-orange-600 font-bold' : 'text-gray-400' }}">{{ row.P2_HAUTE }}</td>
                                <td class="px-6 py-3 text-sm text-center {{ row.P3_NORMALE > 0 ? 'text-yellow-600 font-bold' : 'text-gray-400' }}">{{ row.P3_NORMALE }}</td>
                                <td class="px-6 py-3 text-sm text-center {{ row.P4_BASSE > 0 ? 'text-green-600 font-bold' : 'text-gray-400' }}">{{ row.P4_BASSE }}</td>
                                <td class="px-6 py-3 text-sm text-center font-bold text-gray-900 dark:text-white">{{ row.total }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>

{% endblock %}
