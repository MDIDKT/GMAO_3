{% extends 'layouts/app.html.twig' %}

{% block page_subtitle %}
    Mes demandes
{% endblock %}

{% block page_content %}
    <div class="mb-6">
        <ul class="flex flex-wrap gap-2 border-b border-gray-200">
            <li>
                <a href="{{ path('app_demande_mes_demandes') }}"
                   class="inline-block px-4 py-2 rounded-t-lg {{ statut is null ? 'text-blue-600 border-b-2 border-blue-600' : 'text-gray-600 hover:text-gray-900' }}">
                    Toutes
                </a>
            </li>
            {% for s in statuts %}
                <li>
                    <a href="{{ path('app_demande_mes_demandes', {statut: s.value}) }}"
                       class="inline-block px-4 py-2 rounded-t-lg {{ statut == s ? 'text-blue-600 border-b-2 border-blue-600' : 'text-gray-600 hover:text-gray-900' }}">
                        {{ s.label }}
                    </a>
                </li>
            {% endfor %}
        </ul>
    </div>

    {% if pagination.items is empty %}
        <div class="bg-white rounded-lg shadow p-8 text-center">
            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
            </svg>
            <h3 class="mt-2 text-sm font-medium text-gray-900">Aucune demande</h3>
            <p class="mt-1 text-sm text-gray-500">Vous n'avez pas encore d'demande assignée.</p>
        </div>
    {% else %}
        <div class="grid gap-4">
            {% for demande in pagination.items %}
                {% set statutClass = 'bg-gray-100 text-gray-800' %}
                {% if demande.statut %}
                    {% if demande.statut.value == 'A_QUALIFIER' or demande.statut.value == 'NOUVEAU' %}
                        {% set statutClass = 'bg-gray-100 text-gray-800' %}
                    {% elseif demande.statut.value == 'QUALIFIE' %}
                        {% set statutClass = 'bg-blue-100 text-blue-800' %}
                    {% elseif demande.statut.value == 'PLANIFIE' or demande.statut.value == 'EN_COURS' %}
                        {% set statutClass = 'bg-yellow-100 text-yellow-800' %}
                    {% elseif demande.statut.value == 'CLOTURE' %}
                        {% set statutClass = 'bg-green-100 text-green-800' %}
                    {% elseif demande.statut.value == 'REJETEE' %}
                        {% set statutClass = 'bg-red-100 text-red-800' %}
                    {% endif %}
                {% endif %}

                <div class="bg-white rounded-lg shadow hover:shadow-md transition-shadow p-6">
                    <div class="flex justify-between items-start mb-4">
                        <div class="flex-1">
                            <h3 class="text-lg font-semibold text-gray-900 mb-2">
                                demande #{{ demande.numero }}
                            </h3>
                            <span
                                class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium {{ statutClass }}">
                                {{ demande.statut ? demande.statut.label : 'Non défini' }}
                            </span>
                        </div>
                    </div>

                    <div class="space-y-2 text-sm text-gray-600 mb-4">
                        <div class="flex items-center">
                            <svg class="h-4 w-4 mr-2 text-gray-400" fill="none" viewBox="0 0 24 24"
                                 stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                            </svg>
                            <span>Créée le: {{ demande.createdAt|date('d/m/Y') }}</span>
                        </div>
                        {% if demande.site %}
                            <div class="flex items-center">
                                <svg class="h-4 w-4 mr-2 text-gray-400" fill="none" viewBox="0 0 24 24"
                                     stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                                </svg>
                                <span>Site: {{ demande.site.nom }}</span>
                            </div>
                        {% endif %}
                        {% if demande.priorite %}
                            <div class="flex items-center">
                                <svg class="h-4 w-4 mr-2 text-gray-400" fill="none" viewBox="0 0 24 24"
                                     stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                                </svg>
                                <span>Priorité: {{ demande.priorite.label }}</span>
                            </div>
                        {% endif %}
                    </div>

                    <div class="flex gap-2">
                        <a href="{{ path('app_demande_show', {id: demande.id}) }}"
                           class="inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-sm leading-4 font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                            Voir détails
                        </a>
                    </div>
                </div>
            {% endfor %}
        </div>

        {% if pagination.pageCount > 1 %}
            <div class="mt-6 flex justify-center">
                <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                    {% if pagination.currentPageNumber > 1 %}
                        <a href="{{ path('app_demande_mes_demandes', {page: pagination.currentPageNumber - 1, statut: statut ? statut.value : null}) }}"
                           class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50">
                            Précédent
                        </a>
                    {% endif %}

                    {% for page in 1..pagination.pageCount %}
                        <a href="{{ path('app_demande_mes_demandes', {page: page, statut: statut ? statut.value : null}) }}"
                           class="relative inline-flex items-center px-4 py-2 border border-gray-300 bg-white text-sm font-medium {{ page == pagination.currentPageNumber ? 'text-blue-600 bg-blue-50' : 'text-gray-700 hover:bg-gray-50' }}">
                            {{ page }}
                        </a>
                    {% endfor %}

                    {% if pagination.currentPageNumber < pagination.pageCount %}
                        <a href="{{ path('app_demande_mes_demandes', {page: pagination.currentPageNumber + 1, statut: statut ? statut.value : null}) }}"
                           class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50">
                            Suivant
                        </a>
                    {% endif %}
                </nav>
            </div>
        {% endif %}
    {% endif %}
{% endblock %}

