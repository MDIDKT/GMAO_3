{% set inputClass = 'block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary transition' %}
{% set labelClass = 'block text-sm font-medium text-gray-700 mb-2' %}
{% set cancelPath = cancel_path|default(path('app_batiment_index')) %}

{{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
    <div>
        {{ form_label(form.nom, null, {'label_attr': {'class': labelClass}}) }}
        {{ form_widget(form.nom, {'attr': {'class': inputClass, 'placeholder': 'Ex: Batiment A'}}) }}
        {{ form_errors(form.nom) }}
    </div>

    <div>
        {{ form_label(form.etage, null, {'label_attr': {'class': labelClass}}) }}
        {{ form_widget(form.etage, {'attr': {'class': inputClass, 'placeholder': 'RDC / R+1'}}) }}
        {{ form_errors(form.etage) }}
    </div>

    <div>
        {{ form_label(form.site, null, {'label_attr': {'class': labelClass}}) }}
        {{ form_widget(form.site, {'attr': {'class': inputClass}}) }}
        {{ form_errors(form.site) }}
    </div>

    <div>
        <label class="{{ labelClass }}">Statut</label>
        <div class="flex items-center gap-2">
            {{ form_widget(form.actif, {'attr': {'class': 'h-4 w-4 text-primary border-gray-300 rounded focus:ring-primary'}}) }}
            {{ form_label(form.actif, 'Actif', {'label_attr': {'class': 'text-sm text-gray-700 mb-0'}}) }}
        </div>
        {{ form_errors(form.actif) }}
    </div>

    <div class="border-t border-gray-200 pt-6 flex items-center justify-between">
        <a href="{{ cancelPath }}" class="px-6 py-3 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition font-medium">
            Annuler
        </a>
        <button class="px-6 py-3 bg-primary hover:bg-blue-600 text-white rounded-lg transition font-medium">
            {{ button_label|default('Enregistrer') }}
        </button>
    </div>
{{ form_end(form) }}
