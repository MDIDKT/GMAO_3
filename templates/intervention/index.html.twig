{% extends 'layouts/app.html.twig' %}

{% block page_title %}Interventions{% endblock %}
{% block page_subtitle %}Gestion des interventions de maintenance{% endblock %}

{% block page_actions %}
{% endblock %}

{% block page_content %}
    <div class="bg-white dark:bg-fonddeux rounded-2xl shadow-md dark:shadow-none border border-gray-200 dark:border-white/10 p-6 mb-6">
        <form method="get" class="flex flex-wrap items-end gap-4">
            <div class="flex-1 min-w-[200px]">
                <label for="statut" class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1">Statut</label>
                <select id="statut" name="statut"
                        class="w-full rounded-xl border-gray-300 dark:border-white/10 shadow-sm focus:ring-primary focus:border-primary bg-gray-50 dark:bg-fondun text-gray-900 dark:text-white">
                    <option value="">Tous les statuts</option>
                    {% for st in statuts %}
                        <option
                            value="{{ st.value }}" {{ statut and statut.value == st.value ? 'selected' : '' }}>{{ st.label() }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="flex gap-3">
                <a href="{{ path('app_intervention_index') }}"
                   class="px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-200 bg-gray-100 dark:bg-fondun rounded-xl hover:bg-gray-200 dark:hover:bg-white/5 transition">Réinitialiser</a>
                <button type="submit"
                        class="px-6 py-2 text-sm font-medium text-white bg-primary rounded-xl hover:bg-primary/90 transition">
                    Filtrer
                </button>
            </div>
        </form>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
        <div class="bg-white dark:bg-fonddeux rounded-2xl shadow-md dark:shadow-none border border-gray-200 dark:border-white/10 p-4 kpi-accent-danger">
            <p class="text-sm text-gray-600 dark:text-gray-300 font-medium">A planifier</p>
            <p class="text-2xl font-bold text-gray-800 dark:text-white mt-1">{{ aPlanifierCount }}</p>
        </div>
        <div class="bg-white dark:bg-fonddeux rounded-2xl shadow-md dark:shadow-none border border-gray-200 dark:border-white/10 p-4 kpi-accent-warning">
            <p class="text-sm text-gray-600 dark:text-gray-300 font-medium">En cours</p>
            <p class="text-2xl font-bold text-gray-800 dark:text-white mt-1">{{ enCoursCount }}</p>
        </div>
        <div class="bg-white dark:bg-fonddeux rounded-2xl shadow-md dark:shadow-none border border-gray-200 dark:border-white/10 p-4 kpi-accent-success">
            <p class="text-sm text-gray-600 dark:text-gray-300 font-medium">Terminees / Validees</p>
            <p class="text-2xl font-bold text-gray-800 dark:text-white mt-1">{{ termineeCount }}</p>
        </div>
    </div>

    <div class="bg-white dark:bg-fonddeux rounded-2xl shadow-md dark:shadow-none border border-gray-200 dark:border-white/10 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 dark:border-white/10 bg-gray-50 dark:bg-fondun">
            <p class="text-sm font-medium text-gray-700 dark:text-gray-200">{{ totalCount }} interventions trouvees</p>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-gray-50 dark:bg-fondun border-b border-gray-200 dark:border-white/10">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Numero</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Demande</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Technicien</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date planifiee</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Duree</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Statut</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                </tr>
                </thead>
                <tbody class="bg-white dark:bg-fonddeux divide-y divide-gray-200 dark:divide-white/10">
                {% for intervention in pagination %}
                    {% set statutClass = 'bg-gray-100 dark:bg-gray-900/30 text-gray-800 dark:text-gray-400' %}
                    {% if intervention.statut %}
                        {% if intervention.statut.value == 'A_PLANIFIER' %}
                            {% set statutClass = 'bg-gray-100 dark:bg-gray-900/30 text-gray-800 dark:text-gray-400' %}
                        {% elseif intervention.statut.value == 'PLANIFIE' %}
                            {% set statutClass = 'bg-yellow-100 dark:bg-yellow-900/30 text-yellow-800 dark:text-yellow-400' %}
                        {% elseif intervention.statut.value == 'EN_COURS' %}
                            {% set statutClass = 'bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-400' %}
                        {% elseif intervention.statut.value == 'TERMINEE' %}
                            {% set statutClass = 'bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-400' %}
                        {% elseif intervention.statut.value == 'VALIDEE' %}
                            {% set statutClass = 'bg-emerald-100 dark:bg-emerald-900/30 text-emerald-800 dark:text-emerald-400' %}
                        {% endif %}
                    {% endif %}

                    <tr class="hover:bg-gray-50 dark:hover:bg-white/5 transition">
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 dark:text-white">
                            {{ intervention.numero ?: ('INT-' ~ intervention.id) }}
                        </td>
                        <td class="px-6 py-4">
                            {% if intervention.demande %}
                                <div class="text-sm font-medium text-gray-900 dark:text-white">{{ intervention.demande.titre }}</div>
                                <div class="text-xs text-gray-500">{{ intervention.demande.numero ?: ('DEM-' ~ intervention.demande.id) }}</div>
                            {% else %}
                                <span class="text-sm text-gray-500">-</span>
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700 dark:text-gray-200">
                            {% if intervention.technicien %}
                                {{ intervention.technicien.prenom }} {{ intervention.technicien.nom }}
                            {% else %}
                                -
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700 dark:text-gray-200">
                            {{ intervention.datePlanifiee ? intervention.datePlanifiee|date('d/m/Y H:i') : '-' }}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700 dark:text-gray-200">
                            {{ intervention.dureeMinutes ? intervention.dureeMinutes ~ ' min' : '-' }}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="px-3 py-1 inline-flex text-xs leading-5 font-semibold rounded-full {{ statutClass }}">
                                {{ intervention.statut ? intervention.statut.label() : '-' }}
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                            <div class="flex items-center gap-4">
                                <a href="{{ path('app_intervention_show', {'id': intervention.id}) }}"
                                   class="text-primary hover:text-primary/80">Voir</a>
                                <a href="{{ path('app_intervention_edit', {'id': intervention.id}) }}"
                                   class="text-gray-700 dark:text-gray-200 hover:text-gray-900 dark:hover:text-white">Modifier</a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="px-6 py-10 text-center text-gray-500">Aucune intervention trouvee.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {% if pagination.pageCount > 1 %}
        <div class="mt-6 flex justify-center">
            <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px">
                {% if pagination.currentPageNumber > 1 %}
                    <a href="{{ path('app_intervention_index', {page: pagination.currentPageNumber - 1, statut: selectedStatut}) }}"
                       class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 dark:border-white/10 bg-white dark:bg-fonddeux text-sm font-medium text-gray-500 hover:bg-gray-50 dark:hover:bg-white/5">
                        Precedent
                    </a>
                {% endif %}
                {% for page in 1..pagination.pageCount %}
                    <a href="{{ path('app_intervention_index', {page: page, statut: selectedStatut}) }}"
                       class="relative inline-flex items-center px-4 py-2 border border-gray-300 dark:border-white/10 bg-white dark:bg-fonddeux text-sm font-medium {{ page == pagination.currentPageNumber ? 'text-fondcinq bg-fondcinq/10 dark:bg-fondcinq/15 dark:text-fondcinq' : 'text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-white/5' }}">
                        {{ page }}
                    </a>
                {% endfor %}
                {% if pagination.currentPageNumber < pagination.pageCount %}
                    <a href="{{ path('app_intervention_index', {page: pagination.currentPageNumber + 1, statut: selectedStatut}) }}"
                       class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 dark:border-white/10 bg-white dark:bg-fonddeux text-sm font-medium text-gray-500 hover:bg-gray-50 dark:hover:bg-white/5">
                        Suivant
                    </a>
                {% endif %}
            </nav>
        </div>
    {% endif %}
{% endblock %}
