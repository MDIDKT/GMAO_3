{% set inputClass = 'block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary transition' %}
{% set labelClass = 'block text-sm font-medium text-gray-700 mb-2' %}
{% set cancelPath = cancel_path|default(path('app_intervention_index')) %}

{{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
        {{ form_label(form.demande, null, {'label_attr': {'class': labelClass}}) }}
        {{ form_widget(form.demande, {'attr': {'class': inputClass}}) }}
        {{ form_errors(form.demande) }}
    </div>
    <div>
        {{ form_label(form.statut, null, {'label_attr': {'class': labelClass}}) }}
        {{ form_widget(form.statut, {'attr': {'class': inputClass}}) }}
        {{ form_errors(form.statut) }}
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
        {{ form_label(form.technicien, null, {'label_attr': {'class': labelClass}}) }}
        {{ form_widget(form.technicien, {'attr': {'class': inputClass}}) }}
        {{ form_errors(form.technicien) }}
    </div>
    <div>
        {{ form_label(form.planificateur, null, {'label_attr': {'class': labelClass}}) }}
        {{ form_widget(form.planificateur, {'attr': {'class': inputClass}}) }}
        {{ form_errors(form.planificateur) }}
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div>
        {{ form_label(form.datePlanifiee, null, {'label_attr': {'class': labelClass}}) }}
        {{ form_widget(form.datePlanifiee, {'attr': {'class': inputClass}}) }}
        {{ form_errors(form.datePlanifiee) }}
    </div>
    <div>
        {{ form_label(form.dateDebut, null, {'label_attr': {'class': labelClass}}) }}
        {{ form_widget(form.dateDebut, {'attr': {'class': inputClass}}) }}
        {{ form_errors(form.dateDebut) }}
    </div>
    <div>
        {{ form_label(form.dateFin, null, {'label_attr': {'class': labelClass}}) }}
        {{ form_widget(form.dateFin, {'attr': {'class': inputClass}}) }}
        {{ form_errors(form.dateFin) }}
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
        {{ form_label(form.dureeMinutes, null, {'label_attr': {'class': labelClass}}) }}
        {{ form_widget(form.dureeMinutes, {'attr': {'class': inputClass, 'placeholder': 'Duree en minutes'}}) }}
        {{ form_errors(form.dureeMinutes) }}
    </div>
    <div>
        {{ form_label(form.organisation, null, {'label_attr': {'class': labelClass}}) }}
        {{ form_widget(form.organisation, {'attr': {'class': inputClass}}) }}
        {{ form_errors(form.organisation) }}
    </div>
</div>

<div>
    {{ form_label(form.compteRendu, null, {'label_attr': {'class': labelClass}}) }}
    {{ form_widget(form.compteRendu, {'attr': {'class': inputClass, 'rows': 5, 'placeholder': 'Compte rendu de l\'intervention'}}) }}
    {{ form_errors(form.compteRendu) }}
</div>

<div>
    {{ form_label(form.notes, null, {'label_attr': {'class': labelClass}}) }}
    {{ form_widget(form.notes, {'attr': {'class': inputClass, 'rows': 3, 'placeholder': 'Notes complementaires'}}) }}
    {{ form_errors(form.notes) }}
</div>

<div class="border-t border-gray-200 pt-6 flex items-center justify-between">
    <a href="{{ cancelPath }}"
       class="px-6 py-3 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition font-medium">
        Annuler
    </a>
    <button class="px-6 py-3 bg-primary hover:bg-primary/90 text-white rounded-lg transition font-medium">
        {{ button_label|default('Enregistrer') }}
    </button>
</div>
{{ form_end(form) }}
