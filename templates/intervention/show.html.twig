{% extends 'layouts/app.html.twig' %}

{% block page_title %}{{ intervention.numero ?: ('INT-' ~ intervention.id) }}{% endblock %}
{% block page_subtitle %}Détail de l'intervention{% endblock %}

{% block page_content %}
    {% set statutClass = 'bg-gray-100 dark:bg-fondun text-gray-800 dark:text-white' %}
    {% if intervention.statut %}
        {% if intervention.statut.value == 'A_PLANIFIER' %}
            {% set statutClass = 'bg-gray-100 dark:bg-fondun text-gray-800 dark:text-white' %}
        {% elseif intervention.statut.value == 'PLANIFIE' %}
            {% set statutClass = 'bg-yellow-100 dark:bg-yellow-900/30 text-yellow-800 dark:text-yellow-400' %}
        {% elseif intervention.statut.value == 'EN_COURS' %}
            {% set statutClass = 'bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-400' %}
        {% elseif intervention.statut.value == 'TERMINEE' %}
            {% set statutClass = 'bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-400' %}
        {% elseif intervention.statut.value == 'VALIDEE' %}
            {% set statutClass = 'bg-emerald-100 dark:bg-emerald-900/30 text-emerald-800 dark:text-emerald-400' %}
        {% endif %}
    {% endif %}

    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
        <div
            class="bg-white dark:bg-fonddeux rounded-2xl shadow-md dark:shadow-none border border-gray-200 dark:border-white/10 p-6 h-fit">
            <div class="flex items-start justify-between mb-6">
                <div>
                    <h3 class="text-xl font-bold text-gray-800 dark:text-white mb-2">Informations de l'intervention</h3>
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="px-3 py-1 text-sm font-semibold rounded-full {{ statutClass }}">
                            {{ intervention.statut ? intervention.statut.label() : 'Statut non défini' }}
                        </span>
                    </div>
                </div>
            </div>

            <div class="space-y-4">
                <div>
                    <p class="text-sm font-medium text-gray-500 mb-1">Numéro</p>
                    <p class="text-gray-800 dark:text-white">{{ intervention.numero ?: '-' }}</p>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-500 mb-1">Demande associée</p>
                    <p class="text-gray-800 dark:text-white">
                        {% if intervention.demande %}
                            <a href="{{ path('app_demande_show', {'id': intervention.demande.id}) }}" class="text-primary hover:text-primary/80">
                                {{ intervention.demande.numero ?: ('DEM-' ~ intervention.demande.id) }} — {{ intervention.demande.titre }}
                            </a>
                        {% else %}
                            -
                        {% endif %}
                    </p>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <p class="text-sm font-medium text-gray-500 mb-1">Technicien</p>
                        <p class="text-gray-800 dark:text-white">
                            {% if intervention.technicien %}
                                {{ intervention.technicien.prenom }} {{ intervention.technicien.nom }}
                            {% else %}
                                -
                            {% endif %}
                        </p>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-gray-500 mb-1">Planificateur</p>
                        <p class="text-gray-800 dark:text-white">
                            {% if intervention.planificateur %}
                                {{ intervention.planificateur.prenom }} {{ intervention.planificateur.nom }}
                            {% else %}
                                -
                            {% endif %}
                        </p>
                    </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <p class="text-sm font-medium text-gray-500 mb-1">Date planifiée</p>
                        <p class="text-gray-800 dark:text-white">{{ intervention.datePlanifiee ? intervention.datePlanifiee|date('d/m/Y H:i') : '-' }}</p>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-gray-500 mb-1">Date début</p>
                        <p class="text-gray-800 dark:text-white">{{ intervention.dateDebut ? intervention.dateDebut|date('d/m/Y H:i') : '-' }}</p>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-gray-500 mb-1">Date fin</p>
                        <p class="text-gray-800 dark:text-white">{{ intervention.dateFin ? intervention.dateFin|date('d/m/Y H:i') : '-' }}</p>
                    </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <p class="text-sm font-medium text-gray-500 mb-1">Durée</p>
                        <p class="text-gray-800 dark:text-white">{{ intervention.dureeMinutes ? intervention.dureeMinutes ~ ' minutes' : '-' }}</p>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-gray-500 mb-1">Organisation</p>
                        <p class="text-gray-800 dark:text-white">{{ intervention.organisation ? intervention.organisation.nom : '-' }}</p>
                    </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <p class="text-sm font-medium text-gray-500 mb-1">ID intervention</p>
                        <p class="text-gray-800 dark:text-white">{{ intervention.id ?: '-' }}</p>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-gray-500 mb-1">Créée le</p>
                        <p class="text-gray-800 dark:text-white">{{ intervention.createdAt ? intervention.createdAt|date('d/m/Y H:i') : '-' }}</p>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-gray-500 mb-1">Mise à jour</p>
                        <p class="text-gray-800 dark:text-white">{{ intervention.updatedAt ? intervention.updatedAt|date('d/m/Y H:i') : '-' }}</p>
                    </div>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-500 mb-1">Notes</p>
                    <p class="text-gray-800 dark:text-white whitespace-pre-line">{{ intervention.notes ?: '-' }}</p>
                </div>
                {# Galerie groupée par type — toujours visible #}
                {% set photosAvant = intervention.photos|filter(p => p.typePhoto.value == 'AVANT') %}
                {% set photosApres = intervention.photos|filter(p => p.typePhoto.value == 'APRES') %}
                {% set photosComplement = intervention.photos|filter(p => p.typePhoto.value == 'COMPLEMENT') %}

                {% if intervention.photos|length > 0 %}
                    <div class="mt-2 space-y-4">
                        <p class="text-sm font-medium text-gray-500">Photos</p>
                        {% for label, photoGroup in {'Avant': photosAvant, 'Après': photosApres, 'Complément': photosComplement} %}
                            {% if photoGroup|length > 0 %}
                                <div>
                                    <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2">{{ label }}</p>
                                    <div class="flex flex-wrap gap-3">
                                        {% for photo in photoGroup %}
                                            <a href="{{ path('app_intervention_photo_show', {'id': photo.id}) }}" target="_blank" rel="noopener noreferrer">
                                                <img src="{{ path('app_intervention_photo_show', {'id': photo.id}) }}"
                                                     alt="{{ photo.originalName ?: 'Photo' }}"
                                                     class="h-24 w-24 object-cover rounded-xl border border-gray-200 dark:border-white/10 hover:opacity-80 transition">
                                            </a>
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                {% endif %}

            </div>
        </div>

        <div
            class="bg-white dark:bg-fonddeux rounded-2xl shadow-md dark:shadow-none border border-gray-200 dark:border-white/10 p-6 h-fit">
            <h3 class="text-lg font-bold text-gray-800 dark:text-white mb-4">Gestion de l'intervention</h3>
            <div class="grid grid-cols-2 gap-3">
                    {% if intervention.statut.value == 'PLANIFIE' %}
                        <form method="post" action="{{ path('app_intervention_demarrer', {'id': intervention.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('demarrer' ~ intervention.id) }}">
                            <button type="submit"
                                    class="w-full px-4 py-2.5 bg-primary hover:bg-primary/90 text-white rounded-xl transition font-medium text-sm">
                                Démarrer
                            </button>
                        </form>
                    {% endif %}

                {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_PLANIFICATEUR') %}
                    <a href="{{ path('app_intervention_edit', {'id': intervention.id}) }}"
                       class="inline-flex items-center justify-center w-full px-4 py-2.5 border border-gray-300 dark:border-white/10 text-gray-700 dark:text-gray-200 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5 transition font-medium text-sm">
                        Modifier
                    </a>
                {% endif %}

                {% if intervention.statut.value == 'TERMINEE' and (is_granted('ROLE_PLANIFICATEUR') or is_granted('ROLE_ADMIN')) %}
                    <form method="post" action="{{ path('app_intervention_valider', {'id': intervention.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('valider' ~ intervention.id) }}">
                        <button type="submit"
                                class="w-full px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl transition font-medium text-sm">
                            Valider
                        </button>
                    </form>
                {% endif %}

                <a href="{{ is_granted('ROLE_ADMIN') or is_granted('ROLE_PLANIFICATEUR') ? path('app_intervention_index') : path('app_intervention_mes_interventions') }}"
                   class="inline-flex items-center justify-center w-full px-4 py-2.5 border border-gray-300 dark:border-white/10 text-gray-700 dark:text-gray-200 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5 transition font-medium text-sm">
                    Retour à la liste
                </a>
            </div>

            <div class="border-t border-gray-200 dark:border-white/10 pt-4 mt-4">
                <p class="text-sm font-medium text-gray-500 mb-1">Compte rendu</p>
                {% if intervention.compteRendu %}
                    <p class="text-gray-800 dark:text-white whitespace-pre-line">{{ intervention.compteRendu }}</p>
                {% else %}
                    <p class="text-gray-400 dark:text-gray-500 italic">Aucun compte rendu pour le moment</p>
                {% endif %}
            </div>

            {% if intervention.statut.value == 'EN_COURS' %}
                <div class="border-t border-gray-200 dark:border-white/10 pt-4 mt-4">
                    <p class="text-sm font-medium text-gray-500 mb-3">Clôturer l'intervention</p>
                        <form method="post" action="{{ path('app_intervention_terminer', {'id': intervention.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('terminer' ~ intervention.id) }}">
                            <div class="flex flex-col sm:flex-row gap-3 items-start">
                                <div class="flex-1 w-full">
                                    <label for="compteRendu"></label><textarea id="compteRendu" name="compte_rendu"
                                                                               rows="1" required
                                                                               class="w-full rounded-xl border-gray-300 dark:border-white/10 shadow-sm focus:ring-green-500 focus:border-green-500 text-sm bg-gray-50 dark:bg-fondun text-gray-900 dark:text-white"
                                                                               placeholder="Compte rendu des travaux...">{{ intervention.compteRendu }}</textarea>
                                </div>
                                <button type="submit"
                                        class="px-4 py-2.5 bg-green-600 hover:bg-green-700 text-white rounded-xl transition font-medium text-sm whitespace-nowrap">
                                    Terminer
                                </button>
                            </div>
                        </form>
                </div>
            {% endif %}

            {% if intervention.statut.value == 'EN_COURS' and app.user == intervention.technicien %}
                <div class="border-t border-gray-200 dark:border-white/10 pt-4 mt-4">
                    <p class="text-sm font-medium text-gray-500 mb-3">Ajouter des photos</p>
                    {{ form_start(photoForm, {'attr': {'class': 'space-y-3'}}) }}
                    {{ form_errors(photoForm) }}
                    {{ form_row(photoForm.typePhoto) }}
                    {{ form_row(photoForm.photos) }}
                    <button type="submit"
                            class="px-4 py-2 bg-primary hover:bg-primary/90 text-white rounded-xl transition font-medium text-sm">
                        Envoyer
                            </button>
                    {{ form_end(photoForm) }}
                </div>
            {% endif %}

            <div class="border-t border-gray-200 dark:border-white/10 pt-4 mt-4">
                    {{ include('intervention/_delete_form.html.twig') }}
                </div>
        </div>
    </div>
{% endblock %}
