{% extends 'layouts/app.html.twig' %}

{% block page_title %}{{ intervention.numero ?: ('INT-' ~ intervention.id) }}{% endblock %}
{% block page_subtitle %}Detail de l'intervention{% endblock %}

{% block page_actions %}
    <a href="{{ path('app_intervention_edit', {'id': intervention.id}) }}"
       class="px-4 py-2 border border-gray-300 dark:border-white/10 text-gray-700 dark:text-gray-200 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5 transition font-medium">
        Modifier
    </a>
{% endblock %}

{% block page_content %}
    {% set statutClass = 'bg-gray-100 text-gray-800' %}
    {% if intervention.statut %}
        {% if intervention.statut.value == 'A_PLANIFIER' %}
            {% set statutClass = 'bg-gray-100 text-gray-800' %}
        {% elseif intervention.statut.value == 'PLANIFIE' %}
            {% set statutClass = 'bg-yellow-100 text-yellow-800' %}
        {% elseif intervention.statut.value == 'EN_COURS' %}
            {% set statutClass = 'bg-blue-100 text-blue-800' %}
        {% elseif intervention.statut.value == 'TERMINEE' %}
            {% set statutClass = 'bg-green-100 text-green-800' %}
        {% elseif intervention.statut.value == 'VALIDEE' %}
            {% set statutClass = 'bg-emerald-100 text-emerald-800' %}
        {% endif %}
    {% endif %}

    <div class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 bg-white dark:bg-fonddeux rounded-2xl shadow-md dark:shadow-none border border-gray-200 dark:border-white/10 p-6">
            <div class="flex items-start justify-between mb-6">
                <div>
                    <h3 class="text-xl font-bold text-gray-800 mb-2">Informations de l'intervention</h3>
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="px-3 py-1 text-sm font-semibold rounded-full {{ statutClass }}">
                            {{ intervention.statut ? intervention.statut.label() : 'Statut non defini' }}
                        </span>
                    </div>
                </div>
            </div>

            <div class="space-y-4">
                <div>
                    <p class="text-sm font-medium text-gray-500 mb-1">Numero</p>
                    <p class="text-gray-800">{{ intervention.numero ?: '-' }}</p>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-500 mb-1">Demande associee</p>
                    <p class="text-gray-800">
                        {% if intervention.demande %}
                            <a href="{{ path('app_demande_show', {'id': intervention.demande.id}) }}" class="text-primary hover:text-primary/80">
                                {{ intervention.demande.numero ?: ('DEM-' ~ intervention.demande.id) }} — {{ intervention.demande.titre }}
                            </a>
                        {% else %}
                            -
                        {% endif %}
                    </p>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <p class="text-sm font-medium text-gray-500 mb-1">Technicien</p>
                        <p class="text-gray-800">
                            {% if intervention.technicien %}
                                {{ intervention.technicien.prenom }} {{ intervention.technicien.nom }}
                            {% else %}
                                -
                            {% endif %}
                        </p>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-gray-500 mb-1">Planificateur</p>
                        <p class="text-gray-800">
                            {% if intervention.planificateur %}
                                {{ intervention.planificateur.prenom }} {{ intervention.planificateur.nom }}
                            {% else %}
                                -
                            {% endif %}
                        </p>
                    </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <p class="text-sm font-medium text-gray-500 mb-1">Date planifiee</p>
                        <p class="text-gray-800">{{ intervention.datePlanifiee ? intervention.datePlanifiee|date('d/m/Y H:i') : '-' }}</p>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-gray-500 mb-1">Date debut</p>
                        <p class="text-gray-800">{{ intervention.dateDebut ? intervention.dateDebut|date('d/m/Y H:i') : '-' }}</p>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-gray-500 mb-1">Date fin</p>
                        <p class="text-gray-800">{{ intervention.dateFin ? intervention.dateFin|date('d/m/Y H:i') : '-' }}</p>
                    </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <p class="text-sm font-medium text-gray-500 mb-1">Duree</p>
                        <p class="text-gray-800">{{ intervention.dureeMinutes ? intervention.dureeMinutes ~ ' minutes' : '-' }}</p>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-gray-500 mb-1">Organisation</p>
                        <p class="text-gray-800">{{ intervention.organisation ? intervention.organisation.nom : '-' }}</p>
                    </div>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-500 mb-1">Compte rendu</p>
                    <p class="text-gray-800 whitespace-pre-line">{{ intervention.compteRendu ?: '-' }}</p>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-500 mb-1">Notes</p>
                    <p class="text-gray-800 whitespace-pre-line">{{ intervention.notes ?: '-' }}</p>
                </div>
                {# Galerie groupée par type — toujours visible #}
                {% set photosAvant = intervention.photos|filter(p => p.typePhoto.value == 'AVANT') %}
                {% set photosApres = intervention.photos|filter(p => p.typePhoto.value == 'APRES') %}
                {% set photosComplement = intervention.photos|filter(p => p.typePhoto.value == 'COMPLEMENT') %}

                {% if intervention.photos|length > 0 %}
                    <div class="mt-2 space-y-4">
                        <p class="text-sm font-medium text-gray-500">Photos</p>
                        {% for label, photoGroup in {'Avant': photosAvant, 'Après': photosApres, 'Complément': photosComplement} %}
                            {% if photoGroup|length > 0 %}
                                <div>
                                    <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2">{{ label }}</p>
                                    <div class="flex flex-wrap gap-3">
                                        {% for photo in photoGroup %}
                                            <a href="{{ path('app_intervention_photo_show', {'id': photo.id}) }}" target="_blank">
                                                <img src="{{ path('app_intervention_photo_show', {'id': photo.id}) }}"
                                                     alt="{{ photo.originalName ?: 'Photo' }}"
                                                     class="h-24 w-24 object-cover rounded-xl border border-gray-200 dark:border-white/10 hover:opacity-80 transition">
                                            </a>
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                {% endif %}

                {# Formulaire upload — visible uniquement si EN_COURS ET technicien assigné #}
                {% if intervention.statut.value == 'EN_COURS' and app.user == intervention.technicien %}
                    <div class="mt-4 border-t border-gray-200 pt-4">
                        <p class="text-sm font-medium text-gray-500 mb-3">Ajouter des photos</p>
                        {{ form_start(photoForm, {'attr': {'enctype': 'multipart/form-data', 'class': 'space-y-3'}}) }}
                            {{ form_row(photoForm.typePhoto) }}
                            {{ form_row(photoForm.photos) }}
                            <button type="submit" class="px-4 py-2 bg-primary hover:bg-primary/90 text-white rounded-xl transition font-medium text-sm">
                                Envoyer
                            </button>
                        {{ form_end(photoForm) }}
                    </div>
                {% endif %}
            </div>
        </div>

        <div class="space-y-6">
            <div class="bg-white dark:bg-fonddeux rounded-2xl shadow-md dark:shadow-none border border-gray-200 dark:border-white/10 p-6 kpi-accent-primary">
                <p class="text-sm text-gray-600 dark:text-gray-300 font-medium">ID intervention</p>
                <p class="text-3xl font-bold text-gray-800 dark:text-white mt-1">{{ intervention.id }}</p>
            </div>
            <div class="bg-white dark:bg-fonddeux rounded-2xl shadow-md dark:shadow-none border border-gray-200 dark:border-white/10 p-6 kpi-accent-secondary">
                <p class="text-sm text-gray-600 dark:text-gray-300 font-medium">Creee le</p>
                <p class="text-lg font-semibold text-gray-800 dark:text-white mt-1">{{ intervention.createdAt ? intervention.createdAt|date('d/m/Y H:i') : '-' }}</p>
                <p class="text-sm text-gray-500 mt-2">Maj: {{ intervention.updatedAt ? intervention.updatedAt|date('d/m/Y H:i') : '-' }}</p>
            </div>
            <div class="bg-white dark:bg-fonddeux rounded-2xl shadow-md dark:shadow-none border border-gray-200 dark:border-white/10 p-6">
                <div class="flex flex-col gap-3">
                    <a href="{{ is_granted('ROLE_ADMIN') or is_granted('ROLE_PLANIFICATEUR') ? path('app_intervention_index') : path('app_intervention_mes_interventions') }}"
                       class="text-center px-4 py-2 border border-gray-300 dark:border-white/10 text-gray-700 dark:text-gray-200 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5 transition font-medium">
                        Retour a la liste
                    </a>

                    {% if intervention.statut.value == 'PLANIFIE' %}
                        <form method="post" action="{{ path('app_intervention_demarrer', {'id': intervention.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('demarrer' ~ intervention.id) }}">
                            <button type="submit"
                                    class="w-full px-4 py-2 bg-primary hover:bg-primary/90 text-white rounded-xl transition font-medium">
                                Démarrer
                            </button>
                        </form>
                    {% endif %}

                    {% if intervention.statut.value == 'EN_COURS' %}
                        <form method="post" action="{{ path('app_intervention_terminer', {'id': intervention.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('terminer' ~ intervention.id) }}">
                            <div class="mb-3">
                                <label for="compteRendu" class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1">Compte rendu *</label>
                                <textarea id="compteRendu" name="compte_rendu" rows="3" required
                                          class="w-full rounded-xl border-gray-300 dark:border-white/10 shadow-sm focus:ring-green-500 focus:border-green-500 text-sm bg-gray-50 dark:bg-fondun text-gray-900 dark:text-white"
                                          placeholder="Decrivez les travaux realises...">{{ intervention.compteRendu }}</textarea>
                            </div>
                            <button type="submit"
                                    class="w-full px-4 py-2 bg-green-600 hover:bg-green-700 text-white rounded-xl transition font-medium">
                                Terminer
                            </button>
                        </form>
                    {% endif %}

                    {% if intervention.statut.value == 'TERMINEE' and (is_granted('ROLE_PLANIFICATEUR') or is_granted('ROLE_ADMIN')) %}
                        <form method="post" action="{{ path('app_intervention_valider', {'id': intervention.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('valider' ~ intervention.id) }}">
                            <button type="submit"
                                    class="w-full px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl transition font-medium">
                                Valider
                            </button>
                        </form>
                    {% endif %}

                    {{ include('intervention/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
