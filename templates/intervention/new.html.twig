{% extends 'layouts/app.html.twig' %}

{% block page_title %}Nouvelle intervention{% endblock %}
{% block page_subtitle %}Planification d'une intervention de maintenance{% endblock %}

{% block page_content %}
    <div class="max-w-4xl mx-auto">
        <div class="bg-white dark:bg-fonddeux rounded-2xl shadow-md dark:shadow-none border border-gray-200 dark:border-white/10">
            <div class="px-8 py-6 border-b border-gray-200 dark:border-white/10">
                <h3 class="text-lg font-semibold text-gray-800 dark:text-white">Informations de l'intervention</h3>
                <p class="text-sm text-gray-600 dark:text-gray-300 mt-1">Renseignez les informations principales</p>
            </div>
            <div class="p-8">
                {{ include('intervention/_form.html.twig', {'button_label': 'Enregistrer l\'intervention', 'cancel_path': path('app_intervention_index')}) }}
            </div>
        </div>
    </div>
{% endblock %}
