{% extends 'base.html.twig' %}

{# DEBUG: Ceci est bien layouts/app.html.twig 🟢 #}

{% block title %}{% block page_title %}Sinoko{% endblock %}{% endblock %}

{% block html_class %}dark{% endblock %}

{% block body_class %}bg-gray-100 dark:bg-fondun min-h-screen text-gray-900 dark:text-gray-100{% endblock %}

{% block body %}
    {% set route = app.request.attributes.get('_route') ?? '' %}
    {% set activeClass = 'flex items-center gap-3 px-3 py-2.5 rounded-xl bg-fondcinq/15 text-fondcinq font-medium text-sm' %}
    {% set inactiveClass = 'flex items-center gap-3 px-3 py-2.5 rounded-xl text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-white/5 transition text-sm' %}

    {% set userFullName = app.user ? (app.user.prenom ~ ' ' ~ app.user.nom) : 'Utilisateur' %}
    {% set initials = app.user ? ((app.user.prenom|slice(0, 1) ~ app.user.nom|slice(0, 1))|upper) : 'US' %}

    {# ======== Sidebar nav items macro ======== #}
    {% macro navItems(route, activeClass, inactiveClass, isGrantedAdmin, isGrantedPlanif, isGrantedTech, isGrantedDemandeur, showLabels) %}
        {% if isGrantedAdmin or isGrantedPlanif %}
            <a href="{{ path('app_dashboard_index') }}"
               class="{{ route == 'app_dashboard' ? activeClass : inactiveClass }}" title="Dashboard">
                <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                {% if showLabels %}<span>Dashboard</span>{% else %}<span class="sidebar-label whitespace-nowrap">Dashboard</span>{% endif %}
            </a>
        {% endif %}

        {% if isGrantedAdmin or isGrantedPlanif %}
            <a href="{{ path('app_demande_index') }}" class="{{ route starts with 'app_demande_' ? activeClass : inactiveClass }}" title="Demandes">
                <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                {% if showLabels %}<span>Demandes</span>{% else %}<span class="sidebar-label whitespace-nowrap">Demandes</span>{% endif %}
            </a>

            <a href="{{ path('app_intervention_index') }}" class="{{ route starts with 'app_intervention_' and route != 'app_intervention_mes_interventions' ? activeClass : inactiveClass }}" title="Interventions">
                <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                {% if showLabels %}<span>Interventions</span>{% else %}<span class="sidebar-label whitespace-nowrap">Interventions</span>{% endif %}
            </a>

            <a href="{{ path('app_reporting') }}" class="{{ route == 'app_reporting' ? activeClass : inactiveClass }}" title="Reporting">
                <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                {% if showLabels %}<span>Reporting</span>{% else %}<span class="sidebar-label whitespace-nowrap">Reporting</span>{% endif %}
            </a>
        {% endif %}

        {% if isGrantedDemandeur and not isGrantedAdmin and not isGrantedPlanif %}
            <a href="{{ path('app_demande_mes_demandes') }}" class="{{ route == 'app_demande_mes_demandes' ? activeClass : inactiveClass }}" title="Mes demandes">
                <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                {% if showLabels %}<span>Mes demandes</span>{% else %}<span class="sidebar-label whitespace-nowrap">Mes demandes</span>{% endif %}
            </a>
        {% endif %}

        {% if isGrantedTech and not isGrantedAdmin and not isGrantedPlanif %}
            <a href="{{ path('app_intervention_mes_interventions') }}" class="{{ route == 'app_intervention_mes_interventions' ? activeClass : inactiveClass }}" title="Mes interventions">
                <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                {% if showLabels %}<span>Mes interventions</span>{% else %}<span class="sidebar-label whitespace-nowrap">Mes interventions</span>{% endif %}
            </a>
        {% endif %}

        {% if isGrantedAdmin %}
            <div class="nav-divider"></div>

            <a href="{{ path('app_site_index') }}" class="{{ route starts with 'app_site_' ? activeClass : inactiveClass }}" title="Sites">
                <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                {% if showLabels %}<span>Sites</span>{% else %}<span class="sidebar-label whitespace-nowrap">Sites</span>{% endif %}
            </a>

            <a href="{{ path('app_batiment_index') }}"
               class="{{ route starts with 'app_batiment_' ? activeClass : inactiveClass }}" title="Bâtiments">
                <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21h18M5 21V7l8-4 6 3v15m-10 0V11h4v10"/></svg>
                {% if showLabels %}<span>Bâtiments</span>{% else %}<span class="sidebar-label whitespace-nowrap">Bâtiments</span>{% endif %}
            </a>

            <a href="{{ path('app_equipement_index') }}"
               class="{{ route starts with 'app_equipement_' ? activeClass : inactiveClass }}" title="Équipements">
                <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                {% if showLabels %}<span>Équipements</span>{% else %}<span class="sidebar-label whitespace-nowrap">Équipements</span>{% endif %}
            </a>

            <a href="{{ path('app_categorie_equipement_index') }}"
               class="{{ route starts with 'app_categorie_equipement_' ? activeClass : inactiveClass }}"
               title="Catégories">
                <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
                {% if showLabels %}<span>Catégories équip.</span>{% else %}<span
                    class="sidebar-label whitespace-nowrap">Catégories équip.</span>{% endif %}
            </a>

            <div class="nav-divider"></div>

            <a href="{{ path('app_admin_user_index') }}"
               class="{{ route starts with 'app_admin_user_' ? activeClass : inactiveClass }}" title="Utilisateurs">
                <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                {% if showLabels %}<span>Utilisateurs</span>{% else %}<span class="sidebar-label whitespace-nowrap">Utilisateurs</span>{% endif %}
            </a>
        {% endif %}
    {% endmacro %}

    <div class="flex h-screen">

        {# ======== MOBILE DRAWER ======== #}
        <div id="mobileDrawer" class="drawer-closed fixed inset-0 z-50 lg:hidden">
            <div class="drawer-overlay absolute inset-0 bg-black/60" onclick="closeDrawer()"></div>
            <div class="drawer-panel absolute left-0 top-0 bottom-0 w-72 bg-white dark:bg-fonddeux shadow-2xl flex flex-col rounded-r-2xl overflow-hidden">
                <div class="soft-separator p-5 flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="36" height="36" class="shrink-0">
                            <defs><linearGradient id="sideGrad1" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:#CF9D7B"/><stop offset="100%" style="stop-color:#724B39"/></linearGradient></defs>
                            <polygon points="32,2 58,17 58,47 32,62 6,47 6,17" fill="url(#sideGrad1)"/>
                            <g transform="translate(32,32)" fill="white"><rect x="-2.5" y="-14" width="5" height="18" rx="2.5"/><circle cx="0" cy="-14" r="6" fill="none" stroke="white" stroke-width="3"/><circle cx="0" cy="-14" r="2.5"/><rect x="-4.5" y="4" width="9" height="6" rx="2.5"/></g>
                        </svg>
                        <span class="font-bold text-lg text-gray-900 dark:text-white">Sinoko</span>
                    </div>
                    <button onclick="closeDrawer()" class="p-1.5 rounded-lg hover:bg-gray-100 dark:hover:bg-white/10">
                        <svg class="w-5 h-5 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                    </button>
                </div>
                <nav class="flex-1 p-3 space-y-1 overflow-y-auto">
                    {{ _self.navItems(route, activeClass, inactiveClass, is_granted('ROLE_ADMIN'), is_granted('ROLE_PLANIFICATEUR'), is_granted('ROLE_TECHNICIEN'), is_granted('ROLE_DEMANDEUR'), true) }}
                </nav>
                <div class="p-4 relative top-separator">
                    <div class="flex items-center gap-3 pt-1">
                        <div class="w-9 h-9 bg-gradient-to-br from-fondquatre to-fondcinq/80 rounded-full flex items-center justify-center shadow-sm">
                            <span class="text-white font-semibold text-xs">{{ initials }}</span>
                        </div>
                        <div class="min-w-0 flex-1">
                            <p class="text-sm font-medium text-gray-900 dark:text-white truncate">{{ userFullName }}</p>
                            <div class="flex items-center gap-2 text-xs text-gray-500 truncate">
                                <a href="{{ path('app_profile_index') }}" class="hover:text-primary transition">Mon
                                    profil</a>
                                <span class="text-gray-300 dark:text-gray-600">•</span>
                                <a href="{{ path('app_logout') }}"
                                   class="hover:text-fondcinq transition">Déconnexion</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ======== DESKTOP SIDEBAR (icon-only, expandable) ======== #}
        <aside id="sidebar" class="sidebar-collapsed hidden lg:flex flex-col bg-white dark:bg-fonddeux sidebar-glow shrink-0 z-40 relative">
            <div class="soft-separator p-4 flex items-center justify-between">
                <div class="flex items-center gap-2.5 min-w-0 cursor-pointer" onclick="if(!sidebarExpanded)toggleSidebar()">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="36" height="36" class="shrink-0">
                        <defs><linearGradient id="sideGrad2" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:#CF9D7B"/><stop offset="100%" style="stop-color:#724B39"/></linearGradient></defs>
                        <polygon points="32,2 58,17 58,47 32,62 6,47 6,17" fill="url(#sideGrad2)"/>
                        <g transform="translate(32,32)" fill="white"><rect x="-2.5" y="-14" width="5" height="18" rx="2.5"/><circle cx="0" cy="-14" r="6" fill="none" stroke="white" stroke-width="3"/><circle cx="0" cy="-14" r="2.5"/><rect x="-4.5" y="4" width="9" height="6" rx="2.5"/></g>
                    </svg>
                    <span class="sidebar-label font-bold text-base text-gray-900 dark:text-white whitespace-nowrap">Sinoko</span>
                </div>
                <button onclick="toggleSidebar()" class="sidebar-label w-7 h-7 rounded-lg flex items-center justify-center hover:bg-gray-100 dark:hover:bg-white/10 transition shrink-0" title="Replier">
                    <svg class="w-4 h-4 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7"/></svg>
                </button>
            </div>

            <nav class="flex-1 p-3 space-y-1 overflow-y-auto">
                {{ _self.navItems(route, activeClass, inactiveClass, is_granted('ROLE_ADMIN'), is_granted('ROLE_PLANIFICATEUR'), is_granted('ROLE_TECHNICIEN'), is_granted('ROLE_DEMANDEUR'), false) }}
            </nav>

            <div class="p-3 relative top-separator">
                <div class="flex items-center gap-3 px-1 py-1 pt-3">
                    <div class="w-9 h-9 bg-gradient-to-br from-fondquatre to-fondcinq/80 rounded-full flex items-center justify-center shrink-0 shadow-sm">
                        <span class="text-white font-semibold text-xs">{{ initials }}</span>
                    </div>
                    <div class="sidebar-label min-w-0">
                        <p class="text-sm font-medium text-gray-900 dark:text-white truncate">{{ userFullName }}</p>
                        <div class="flex items-center gap-2 text-xs text-gray-500 truncate">
                            <a href="{{ path('app_profile_index') }}" class="hover:text-primary transition">Mon
                                profil</a>
                            <span class="text-gray-300 dark:text-gray-600">•</span>
                            <a href="{{ path('app_logout') }}" class="hover:text-fondcinq transition">Déconnexion</a>
                        </div>
                    </div>
                </div>
            </div>
        </aside>

        {# ======== MAIN CONTENT ======== #}
        <div class="flex-1 flex flex-col min-w-0">
            <header class="bg-white dark:bg-fonddeux header-glow shrink-0 relative z-10">
                <div class="px-4 lg:px-6 py-3 flex items-center justify-between gap-4">
                    <div class="flex items-center gap-3">
                        <button onclick="openDrawer()" class="lg:hidden p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-white/10">
                            <svg class="w-5 h-5 text-gray-600 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
                        </button>
                        <div>
                            <h2 class="text-xl font-bold text-gray-900 dark:text-white">{% block page_heading %}{{ block('page_title') }}{% endblock %}</h2>
                            <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">{% block page_subtitle %}Gestion de maintenance{% endblock %}</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        {% block page_actions %}{% endblock %}
                        <div class="w-8 h-8 bg-fondquatre rounded-full flex items-center justify-center lg:hidden">
                            <span class="text-white font-semibold text-xs">{{ initials }}</span>
                        </div>
                    </div>
                </div>
            </header>

            <main class="flex-1 overflow-y-auto p-4 lg:p-6">
                {% for type, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="mb-4 px-4 py-3 rounded-xl text-sm font-medium flex items-center gap-2
                            {% if type == 'success' %}bg-green-50 dark:bg-green-900/30 text-green-800 dark:text-green-400 border border-green-200 dark:border-green-800/50
                            {% elseif type == 'danger' %}bg-red-50 dark:bg-red-900/30 text-red-800 dark:text-red-400 border border-red-200 dark:border-red-800/50
                            {% elseif type == 'warning' %}bg-yellow-50 dark:bg-yellow-900/30 text-yellow-800 dark:text-yellow-400 border border-yellow-200 dark:border-yellow-800/50
                            {% else %}bg-blue-50 dark:bg-blue-900/30 text-blue-800 dark:text-blue-400 border border-blue-200 dark:border-blue-800/50{% endif %}">
                            {% if type == 'success' %}
                                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                            {% elseif type == 'danger' %}
                                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
                            {% elseif type == 'warning' %}
                                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
                            {% else %}
                                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            {% endif %}
                            {{ message }}
                        </div>
                    {% endfor %}
                {% endfor %}
                {% block page_content %}{% endblock %}
            </main>
        </div>
    </div>

    <script>
        // Sidebar toggle
        let sidebarExpanded = false;
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            sidebarExpanded = !sidebarExpanded;
            sidebar.classList.toggle('sidebar-collapsed', !sidebarExpanded);
            sidebar.classList.toggle('sidebar-expanded', sidebarExpanded);
        }
        // Mobile drawer
        function openDrawer() {
            const d = document.getElementById('mobileDrawer');
            d.classList.remove('drawer-closed');
            d.classList.add('drawer-open');
        }
        function closeDrawer() {
            const d = document.getElementById('mobileDrawer');
            d.classList.remove('drawer-open');
            d.classList.add('drawer-closed');
        }
    </script>
{% endblock %}
