{% extends 'base.html.twig' %}

{% block title %}{% block page_title %}GMAO{% endblock %}{% endblock %}

{% block body %}
    {% set route = app.request.attributes.get('_route') ?? '' %}
    {% set activeClass = 'flex items-center space-x-3 px-4 py-3 rounded-lg bg-primary/10 text-primary font-medium' %}
    {% set inactiveClass = 'flex items-center space-x-3 px-4 py-3 rounded-lg text-gray-700 hover:bg-gray-100 transition' %}

    {% set userFullName = app.user ? (app.user.prenom ~ ' ' ~ app.user.nom) : 'Utilisateur' %}
    {% set initials = app.user ? ((app.user.prenom|slice(0, 1) ~ app.user.nom|slice(0, 1))|upper) : 'US' %}

    <div class="flex h-screen bg-gray-50">
        <aside class="hidden lg:flex lg:w-64 lg:flex-col bg-white shadow-lg">
            <div class="p-6 border-b border-gray-200">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 bg-primary rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                    </div>
                    <div>
                        <h1 class="text-lg font-bold text-gray-800">GMAO SaaS</h1>
                        <p class="text-xs text-gray-500">Maintenance</p>
                    </div>
                </div>
            </div>

            <nav class="p-4 space-y-1 flex-1">
                <a href="{{ path('app_home') }}" class="{{ route == 'app_home' ? activeClass : inactiveClass }}">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                    </svg>
                    <span>Dashboard</span>
                </a>

                <a href="#" class="{{ inactiveClass }} opacity-70 cursor-not-allowed">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                    </svg>
                    <span>Demandes</span>
                </a>

                <a href="#" class="{{ inactiveClass }} opacity-70 cursor-not-allowed">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    <span>Interventions</span>
                </a>

                <div class="border-t border-gray-200 my-4"></div>

                <a href="{{ path('app_site_index') }}" class="{{ route starts with 'app_site_' ? activeClass : inactiveClass }}">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                    </svg>
                    <span>Sites</span>
                </a>

                <a href="{{ path('app_batiment_index') }}" class="{{ route starts with 'app_batiment_' ? activeClass : inactiveClass }}">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21h18M5 21V7l8-4 6 3v15m-10 0V11h4v10"></path>
                    </svg>
                    <span>Batiments</span>
                </a>

                <a href="{{ path('app_equipement_index') }}" class="{{ route starts with 'app_equipement_' ? activeClass : inactiveClass }}">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                    </svg>
                    <span>Equipements</span>
                </a>

                {% if is_granted('ROLE_ADMIN') %}
                    <div class="border-t border-gray-200 my-4"></div>
                    <a href="{{ path('app_admin_user_inviter') }}" class="{{ route starts with 'app_admin_user_' ? activeClass : inactiveClass }}">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                        </svg>
                        <span>Utilisateurs</span>
                    </a>
                {% endif %}
            </nav>

            <div class="border-t border-gray-200 p-4">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 bg-gray-300 rounded-full flex items-center justify-center">
                        <span class="text-gray-700 font-semibold">{{ initials }}</span>
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-medium text-gray-800 truncate">{{ userFullName }}</p>
                        <p class="text-xs text-gray-500 truncate">{{ app.user ? app.user.userIdentifier : '' }}</p>
                    </div>
                    <a href="{{ path('app_logout') }}" class="text-gray-400 hover:text-gray-600" title="Se déconnecter">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                        </svg>
                    </a>
                </div>
            </div>
        </aside>

        <main class="flex-1 overflow-y-auto">
            <header class="bg-white shadow-sm border-b border-gray-200">
                <div class="px-6 lg:px-8 py-4 flex items-center justify-between gap-4">
                    <div>
                        <h2 class="text-2xl font-bold text-gray-800">{% block page_heading %}{{ block('page_title') }}{% endblock %}</h2>
                        <p class="text-sm text-gray-600 mt-1">{% block page_subtitle %}Gestion de maintenance{% endblock %}</p>
                    </div>
                    <div class="flex items-center gap-3">
                        {% block page_actions %}{% endblock %}
                    </div>
                </div>
            </header>

            <div class="p-6 lg:p-8">
                {% block page_content %}{% endblock %}
            </div>
        </main>
    </div>
{% endblock %}
