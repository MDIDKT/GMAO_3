<table width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;margin:0 auto;font-family:Arial,Helvetica,sans-serif;color:#333;">
    <tr>
        <td style="padding:30px 20px;text-align:center;background:#0C1519;border-radius:12px 12px 0 0;">
            <h1 style="margin:0;color:#CF9D7B;font-size:24px;">GMAO SaaS</h1>
        </td>
    </tr>
    <tr>
        <td style="padding:30px 30px;background:#ffffff;border:1px solid #e5e7eb;">
            <p style="margin:0 0 16px;font-size:16px;color:#333;">Bonjour,</p>
            <p style="margin:0 0 24px;font-size:14px;color:#555;">
                Vous avez demandé la réinitialisation de votre mot de passe. Cliquez sur le bouton ci-dessous pour choisir un nouveau mot de passe.
            </p>
            <table width="100%" cellpadding="0" cellspacing="0">
                <tr>
                    <td style="text-align:center;padding:10px 0 24px;">
                        <a href="{{ url('app_reset_password', {token: resetToken.token}) }}"
                           style="display:inline-block;padding:14px 32px;background:#CF9D7B;color:#0C1519;text-decoration:none;font-weight:bold;font-size:14px;border-radius:8px;">
                            Réinitialiser mon mot de passe
                        </a>
                    </td>
                </tr>
            </table>
            <p style="margin:0 0 8px;font-size:13px;color:#888;">
                Ce lien expirera dans {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.
            </p>
            <p style="margin:0;font-size:13px;color:#888;">
                Si vous n'avez pas fait cette demande, vous pouvez ignorer cet email en toute sécurité.
            </p>
        </td>
    </tr>
    <tr>
        <td style="padding:20px;text-align:center;background:#f9fafb;border-radius:0 0 12px 12px;border:1px solid #e5e7eb;border-top:none;">
            <p style="margin:0;font-size:12px;color:#9ca3af;">GMAO - Gestion de Maintenance Assistée par Ordinateur</p>
        </td>
    </tr>
</table>
