{% extends 'layouts/app.html.twig' %}

{% block page_title %}{{ equipement.nom }}{% endblock %}
{% block page_subtitle %}Détail de l'équipement{% endblock %}

{% block page_actions %}
    <a href="{{ path('app_equipement_edit', {'id': equipement.id}) }}" class="px-4 py-2 border border-gray-300 dark:border-white/10 text-gray-700 dark:text-gray-200 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5 transition font-medium">
        Modifier
    </a>
{% endblock %}

{% block page_content %}
    <div class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 bg-white dark:bg-fonddeux rounded-2xl shadow-md dark:shadow-none border border-gray-200 dark:border-white/10 p-6">
            <div class="flex items-start justify-between mb-6">
                <div>
                    <h3 class="text-xl font-bold text-gray-800 dark:text-white mb-2">Informations de l'équipement</h3>
                    <span class="px-3 py-1 text-sm font-semibold rounded-full {{ equipement.actif ? 'bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-400' : 'bg-gray-100 dark:bg-fondun text-gray-800 dark:text-white' }}">
                        {{ equipement.actif ? 'Actif' : 'Inactif' }}
                    </span>
                </div>
            </div>

            <div class="space-y-4">
                <div>
                    <p class="text-sm font-medium text-gray-500 mb-1">Nom</p>
                    <p class="text-gray-800 dark:text-white">{{ equipement.nom }}</p>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <p class="text-sm font-medium text-gray-500 mb-1">Marque</p>
                        <p class="text-gray-800 dark:text-white">{{ equipement.marque ?: '-' }}</p>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-gray-500 mb-1">Modèle</p>
                        <p class="text-gray-800 dark:text-white">{{ equipement.modele ?: '-' }}</p>
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <p class="text-sm font-medium text-gray-500 mb-1">Numéro de série</p>
                        <p class="text-gray-800 dark:text-white">{{ equipement.numeroDeSerie ?: '-' }}</p>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-gray-500 mb-1">Statut</p>
                        <p class="text-gray-800 dark:text-white">{{ equipement.statut ? equipement.statut.label() : '-' }}</p>
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <p class="text-sm font-medium text-gray-500 mb-1">Site</p>
                        <p class="text-gray-800 dark:text-white">{{ equipement.site ? equipement.site.nom : '-' }}</p>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-gray-500 mb-1">Bâtiment</p>
                        <p class="text-gray-800 dark:text-white">{{ equipement.batiment ? equipement.batiment.nom : '-' }}</p>
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <p class="text-sm font-medium text-gray-500 mb-1">Catégorie</p>
                        <p class="text-gray-800 dark:text-white">{{ equipement.categorie ? equipement.categorie.nom : '-' }}</p>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-gray-500 mb-1">Organisation</p>
                        <p class="text-gray-800 dark:text-white">{{ equipement.organisation ? equipement.organisation.nom : '-' }}</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="space-y-6">
            <div class="bg-white dark:bg-fonddeux rounded-2xl shadow-md dark:shadow-none border border-gray-200 dark:border-white/10 p-6 kpi-accent-primary">
                <p class="text-sm text-gray-600 dark:text-gray-300 font-medium">ID équipement</p>
                <p class="text-3xl font-bold text-gray-800 dark:text-white mt-1">{{ equipement.id }}</p>
            </div>
            <div class="bg-white dark:bg-fonddeux rounded-2xl shadow-md dark:shadow-none border border-gray-200 dark:border-white/10 p-6">
                <div class="flex flex-col gap-3">
                    <a href="{{ path('app_equipement_index') }}" class="text-center px-4 py-2 border border-gray-300 dark:border-white/10 text-gray-700 dark:text-gray-200 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5 transition font-medium">
                        Retour à la liste
                    </a>
                    {{ include('equipement/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
