{% extends 'layouts/app.html.twig' %}

{% block page_title %}Equipements{% endblock %}
{% block page_subtitle %}Gestion des equipements{% endblock %}

{% block page_actions %}
    <a href="{{ path('app_equipement_new') }}" class="bg-primary hover:bg-primary/90 text-white px-4 py-2 rounded-lg font-medium transition flex items-center space-x-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
        </svg>
        <span>Nouvel equipement</span>
    </a>
{% endblock %}

{% block page_content %}
    {% set activeCount = 0 %}
    {% for equipement in equipements %}
        {% if equipement.actif %}
            {% set activeCount = activeCount + 1 %}
        {% endif %}
    {% endfor %}
    {% set totalCount = equipements|length %}
    {% set inactiveCount = totalCount - activeCount %}

    <div class="bg-white rounded-xl shadow-md p-6 mb-6">
        <form method="get" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
            <div>
                <label for="site" class="block text-sm font-medium text-gray-700 mb-2">Site</label>
                <select id="site" name="site" class="block w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary">
                    <option value="">Tous</option>
                    {% for site in sites %}
                        <option value="{{ site.id }}" {{ selectedSite == site.id ? 'selected' : '' }}>{{ site.nom }}</option>
                    {% endfor %}
                </select>
            </div>
            <div>
                <label for="categorie" class="block text-sm font-medium text-gray-700 mb-2">Categorie</label>
                <select id="categorie" name="categorie" class="block w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary">
                    <option value="">Toutes</option>
                    {% for categorie in categories %}
                        <option value="{{ categorie.id }}" {{ selectedCategorie == categorie.id ? 'selected' : '' }}>{{ categorie.nom }}</option>
                    {% endfor %}
                </select>
            </div>
            <div>
                <label for="statut" class="block text-sm font-medium text-gray-700 mb-2">Statut</label>
                <select id="statut" name="statut" class="block w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary">
                    <option value="">Tous</option>
                    {% for statut in statuts %}
                        <option value="{{ statut.value }}" {{ selectedStatut == statut.value ? 'selected' : '' }}>{{ statut.label() }}</option>
                    {% endfor %}
                </select>
            </div>
            <div>
                <label for="actif" class="block text-sm font-medium text-gray-700 mb-2">Actif</label>
                <select id="actif" name="actif" class="block w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary">
                    <option value="" {{ selectedActif == '' ? 'selected' : '' }}>Tous</option>
                    <option value="1" {{ selectedActif == '1' ? 'selected' : '' }}>Actifs</option>
                    <option value="0" {{ selectedActif == '0' ? 'selected' : '' }}>Inactifs</option>
                </select>
            </div>
            <div class="grid grid-cols-2 gap-2 items-end">
                <button type="submit" class="px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary/90 transition font-medium">
                    Filtrer
                </button>
                <a href="{{ path('app_equipement_index') }}" class="text-center px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition font-medium">
                    Reset
                </a>
            </div>
        </form>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
        <div class="bg-white rounded-lg shadow p-4 border-l-4 border-success">
            <p class="text-sm text-gray-600 font-medium">Equipements actifs</p>
            <p class="text-2xl font-bold text-gray-800 mt-1">{{ activeCount }}</p>
        </div>
        <div class="bg-white rounded-lg shadow p-4 border-l-4 border-gray-400">
            <p class="text-sm text-gray-600 font-medium">Equipements inactifs</p>
            <p class="text-2xl font-bold text-gray-800 mt-1">{{ inactiveCount }}</p>
        </div>
        <div class="bg-white rounded-lg shadow p-4 border-l-4 border-primary">
            <p class="text-sm text-gray-600 font-medium">Total equipements</p>
            <p class="text-2xl font-bold text-gray-800 mt-1">{{ totalCount }}</p>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-md overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
            <p class="text-sm font-medium text-gray-700">{{ totalCount }} equipements trouves</p>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-gray-50 border-b border-gray-200">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Nom</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Marque</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Modele</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Serie</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Statut</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actif</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    {% for equipement in equipements %}
                        <tr class="hover:bg-gray-50 transition">
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">{{ equipement.nom }}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">{{ equipement.marque ?: '-' }}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">{{ equipement.modele ?: '-' }}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">{{ equipement.numeroDeSerie ?: '-' }}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">{{ equipement.statut ? equipement.statut.label() : '-' }}</td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="px-3 py-1 inline-flex text-xs leading-5 font-semibold rounded-full {{ equipement.actif ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' }}">
                                    {{ equipement.actif ? 'Actif' : 'Inactif' }}
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                <div class="flex items-center gap-4">
                                    <a href="{{ path('app_equipement_show', {'id': equipement.id}) }}" class="text-primary hover:text-primary/80">Voir</a>
                                    <a href="{{ path('app_equipement_edit', {'id': equipement.id}) }}" class="text-gray-700 hover:text-gray-900">Modifier</a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="px-6 py-10 text-center text-gray-500">Aucun equipement trouve.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
