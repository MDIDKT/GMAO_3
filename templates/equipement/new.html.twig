{% extends 'layouts/app.html.twig' %}

{% block page_title %}Nouvel equipement{% endblock %}
{% block page_subtitle %}Creation d'un equipement{% endblock %}

{% block page_content %}
    <div class="max-w-4xl mx-auto">
        <div class="bg-white rounded-xl shadow-md">
            <div class="px-8 py-6 border-b border-gray-200">
                <h3 class="text-lg font-semibold text-gray-800">Informations de l'equipement</h3>
                <p class="text-sm text-gray-600 mt-1">Renseignez les details techniques</p>
            </div>
            <div class="p-8">
                {{ include('equipement/_form.html.twig', {'button_label': 'Enregistrer l\'equipement', 'cancel_path': path('app_equipement_index')}) }}
            </div>
        </div>
    </div>
{% endblock %}
