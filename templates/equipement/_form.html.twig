{% set inputClass = 'block w-full px-4 py-3 border border-gray-300 dark:border-white/10 rounded-xl focus:ring-2 focus:ring-primary focus:border-primary transition bg-gray-50 dark:bg-fondun text-gray-900 dark:text-white dark:placeholder-gray-500' %}
{% set labelClass = 'block text-sm font-medium text-gray-700 dark:text-gray-200 mb-2' %}
{% set cancelPath = cancel_path|default(path('app_equipement_index')) %}

{{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
            {{ form_label(form.nom, null, {'label_attr': {'class': labelClass}}) }}
            {{ form_widget(form.nom, {'attr': {'class': inputClass}}) }}
            {{ form_errors(form.nom) }}
        </div>
        <div>
            {{ form_label(form.marque, null, {'label_attr': {'class': labelClass}}) }}
            {{ form_widget(form.marque, {'attr': {'class': inputClass}}) }}
            {{ form_errors(form.marque) }}
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
            {{ form_label(form.modele, null, {'label_attr': {'class': labelClass}}) }}
            {{ form_widget(form.modele, {'attr': {'class': inputClass}}) }}
            {{ form_errors(form.modele) }}
        </div>
        <div>
            {{ form_label(form.numeroDeSerie, null, {'label_attr': {'class': labelClass}}) }}
            {{ form_widget(form.numeroDeSerie, {'attr': {'class': inputClass}}) }}
            {{ form_errors(form.numeroDeSerie) }}
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
            {{ form_label(form.statut, null, {'label_attr': {'class': labelClass}}) }}
            {{ form_widget(form.statut, {'attr': {'class': inputClass}}) }}
            {{ form_errors(form.statut) }}
        </div>
        <div>
            {{ form_label(form.categorie, null, {'label_attr': {'class': labelClass}}) }}
            {{ form_widget(form.categorie, {'attr': {'class': inputClass}}) }}
            {{ form_errors(form.categorie) }}
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
            {{ form_label(form.site, null, {'label_attr': {'class': labelClass}}) }}
            {{ form_widget(form.site, {'attr': {'class': inputClass}}) }}
            {{ form_errors(form.site) }}
        </div>
        <div>
            {{ form_label(form.batiment, null, {'label_attr': {'class': labelClass}}) }}
            {{ form_widget(form.batiment, {'attr': {'class': inputClass}}) }}
            {{ form_errors(form.batiment) }}
        </div>
    </div>

    <div>
        <label class="{{ labelClass }}">Statut actif</label>
        <div class="flex items-center gap-2">
            {{ form_widget(form.actif, {'attr': {'class': 'h-4 w-4 text-primary border-gray-300 dark:border-white/10 rounded focus:ring-primary bg-gray-50 dark:bg-fondun'}}) }}
            {{ form_label(form.actif, 'Actif', {'label_attr': {'class': 'text-sm text-gray-700 dark:text-gray-200 mb-0'}}) }}
        </div>
        {{ form_errors(form.actif) }}
    </div>

    <div class="border-t border-gray-200 dark:border-white/10 pt-6 flex items-center justify-between">
        <a href="{{ cancelPath }}" class="px-6 py-3 border border-gray-300 dark:border-white/10 text-gray-700 dark:text-gray-200 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5 transition font-medium">
            Annuler
        </a>
        <button class="px-6 py-3 bg-primary hover:bg-primary/90 text-white rounded-xl transition font-medium">
            {{ button_label|default('Enregistrer') }}
        </button>
    </div>
{{ form_end(form) }}
