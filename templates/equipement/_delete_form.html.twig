<form method="post" action="{{ path('app_equipement_delete', {'id': equipement.id}) }}" onsubmit="return confirm('Etes-vous sur de vouloir supprimer cet equipement ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ equipement.id) }}">
    <button class="w-full px-4 py-2 bg-danger hover:bg-red-600 text-white rounded-xl transition font-medium">Supprimer</button>
</form>
